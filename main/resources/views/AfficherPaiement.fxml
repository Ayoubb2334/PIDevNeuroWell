<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.geometry.Insets?>
<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="controllers.AfficherPaiementController"
            stylesheets="@../style/dashboard.css"
            style="-fx-background-color: #050C07;">

    <!-- ══════════════ HEADER ══════════════ -->
    <top>
        <VBox style="-fx-background-color: linear-gradient(to right, #071A10, #050C07);
                     -fx-border-color: transparent transparent rgba(0,217,255,0.13) transparent;
                     -fx-border-width: 0 0 1 0;
                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.5), 10, 0.2, 0, 4);">

            <!-- Titre + KPIs -->
            <HBox alignment="CENTER_LEFT" spacing="16"
                  style="-fx-padding: 20 32 16 32;">

                <VBox spacing="3">
                    <Label text="⬡  GESTION PAIEMENTS"
                           style="-fx-text-fill: rgba(0,217,255,0.50); -fx-font-family: 'Consolas';
                                  -fx-font-size: 10px; -fx-letter-spacing: 3px;"/>
                    <Label text="Transactions"
                           style="-fx-text-fill: #E8FFF0; -fx-font-family: 'Consolas';
                                  -fx-font-size: 24px; -fx-font-weight: bold;"/>
                </VBox>

                <Region HBox.hgrow="ALWAYS"/>

                <!-- KPI Revenue Total -->
                <VBox alignment="CENTER" spacing="3"
                      style="-fx-background-color: #0D1F12;
                             -fx-border-color: rgba(0,255,136,0.30); -fx-border-width: 1;
                             -fx-border-radius: 14; -fx-background-radius: 14; -fx-padding: 14 24;
                             -fx-effect: dropshadow(gaussian,rgba(0,255,136,0.15),18,0.1,0,3);">
                    <Label text="REVENUE TOTAL"
                           style="-fx-text-fill: rgba(0,217,255,0.45); -fx-font-family:'Consolas';
                                  -fx-font-size:9px; -fx-letter-spacing:2px;"/>
                    <Label fx:id="totalLabel" text="0.00 DT"
                           style="-fx-text-fill: #00FF88; -fx-font-family:'Consolas';
                                  -fx-font-size:20px; -fx-font-weight:bold;
                                  -fx-effect: dropshadow(gaussian,#00FF88,14,0.5,0,0);"/>
                </VBox>

                <!-- KPI Réussis -->
                <VBox alignment="CENTER" spacing="3"
                      style="-fx-background-color: #0D1F12;
                             -fx-border-color: rgba(0,217,255,0.30); -fx-border-width: 1;
                             -fx-border-radius: 14; -fx-background-radius: 14; -fx-padding: 14 24;
                             -fx-effect: dropshadow(gaussian,rgba(0,217,255,0.15),18,0.1,0,3);">
                    <Label text="RÉUSSIS"
                           style="-fx-text-fill: rgba(0,217,255,0.45); -fx-font-family:'Consolas';
                                  -fx-font-size:9px; -fx-letter-spacing:2px;"/>
                    <Label fx:id="successLabel" text="0"
                           style="-fx-text-fill: #00D9FF; -fx-font-family:'Consolas';
                                  -fx-font-size:20px; -fx-font-weight:bold;
                                  -fx-effect: dropshadow(gaussian,#00D9FF,14,0.5,0,0);"/>
                </VBox>

                <!-- KPI Échoués -->
                <VBox alignment="CENTER" spacing="3"
                      style="-fx-background-color: #0D1F12;
                             -fx-border-color: rgba(255,75,110,0.30); -fx-border-width: 1;
                             -fx-border-radius: 14; -fx-background-radius: 14; -fx-padding: 14 24;
                             -fx-effect: dropshadow(gaussian,rgba(255,75,110,0.15),18,0.1,0,3);">
                    <Label text="ÉCHOUÉS"
                           style="-fx-text-fill: rgba(0,217,255,0.45); -fx-font-family:'Consolas';
                                  -fx-font-size:9px; -fx-letter-spacing:2px;"/>
                    <Label fx:id="failLabel" text="0"
                           style="-fx-text-fill: #FF4B6E; -fx-font-family:'Consolas';
                                  -fx-font-size:20px; -fx-font-weight:bold;
                                  -fx-effect: dropshadow(gaussian,#FF4B6E,14,0.5,0,0);"/>
                </VBox>

                <!-- ✅ KPI Montant Moyen (NOUVEAU) -->
                <VBox alignment="CENTER" spacing="3"
                      style="-fx-background-color: #0D1F12;
                             -fx-border-color: rgba(255,179,71,0.30); -fx-border-width: 1;
                             -fx-border-radius: 14; -fx-background-radius: 14; -fx-padding: 14 24;
                             -fx-effect: dropshadow(gaussian,rgba(255,179,71,0.15),18,0.1,0,3);">
                    <Label text="MONTANT MOYEN"
                           style="-fx-text-fill: rgba(0,217,255,0.45); -fx-font-family:'Consolas';
                                  -fx-font-size:9px; -fx-letter-spacing:2px;"/>
                    <Label fx:id="avgLabel" text="0.00 DT"
                           style="-fx-text-fill: #FFB347; -fx-font-family:'Consolas';
                                  -fx-font-size:20px; -fx-font-weight:bold;
                                  -fx-effect: dropshadow(gaussian,#FFB347,14,0.5,0,0);"/>
                </VBox>

            </HBox>

            <!-- ✅ BARRE DE FILTRES -->
            <HBox alignment="CENTER_LEFT" spacing="12"
                  style="-fx-padding: 0 32 16 32;">

                <!-- Recherche -->
                <HBox alignment="CENTER_LEFT" spacing="8" HBox.hgrow="ALWAYS"
                      style="-fx-background-color: #0A1A0D;
                             -fx-border-color: rgba(0,217,255,0.22); -fx-border-width: 1;
                             -fx-border-radius: 10; -fx-background-radius: 10;
                             -fx-padding: 0 14;">
                    <Label text="⌕" style="-fx-text-fill: rgba(0,217,255,0.40); -fx-font-size:16px;"/>
                    <TextField fx:id="searchField"
                               promptText="Rechercher référence, montant, méthode..."
                               HBox.hgrow="ALWAYS"
                               style="-fx-background-color: transparent; -fx-text-fill: #E8FFF0;
                                      -fx-prompt-text-fill: rgba(200,255,220,0.22);
                                      -fx-font-family:'Consolas'; -fx-font-size:12px;
                                      -fx-border-color: transparent; -fx-padding: 10 0;
                                      -fx-focus-color: transparent; -fx-faint-focus-color: transparent;"/>
                </HBox>

                <!-- Filtre Méthode -->
                <VBox spacing="3">
                    <Label text="MÉTHODE"
                           style="-fx-text-fill:rgba(0,217,255,0.40);-fx-font-family:'Consolas';
                                  -fx-font-size:8px;-fx-letter-spacing:1px;"/>
                    <ComboBox fx:id="filterMethode"
                              prefWidth="120"
                              style="-fx-background-color:#0A1A0D;
                                     -fx-border-color:rgba(0,217,255,0.22);-fx-border-width:1;
                                     -fx-border-radius:9;-fx-background-radius:9;
                                     -fx-font-family:'Consolas';-fx-font-size:12px;
                                     -fx-focus-color:transparent;-fx-faint-focus-color:transparent;"/>
                </VBox>

                <!-- Filtre Statut -->
                <VBox spacing="3">
                    <Label text="STATUT"
                           style="-fx-text-fill:rgba(0,217,255,0.40);-fx-font-family:'Consolas';
                                  -fx-font-size:8px;-fx-letter-spacing:1px;"/>
                    <ComboBox fx:id="filterStatut"
                              prefWidth="130"
                              style="-fx-background-color:#0A1A0D;
                                     -fx-border-color:rgba(0,217,255,0.22);-fx-border-width:1;
                                     -fx-border-radius:9;-fx-background-radius:9;
                                     -fx-font-family:'Consolas';-fx-font-size:12px;
                                     -fx-focus-color:transparent;-fx-faint-focus-color:transparent;"/>
                </VBox>

                <!-- Filtre Date Début -->
                <VBox spacing="3">
                    <Label text="DU"
                           style="-fx-text-fill:rgba(0,217,255,0.40);-fx-font-family:'Consolas';
                                  -fx-font-size:8px;-fx-letter-spacing:1px;"/>
                    <DatePicker fx:id="filterDateDebut"
                                prefWidth="138"
                                promptText="Date début"
                                style="-fx-background-color:#0A1A0D;
                                       -fx-border-color:rgba(0,217,255,0.22);-fx-border-width:1;
                                       -fx-border-radius:9;-fx-background-radius:9;
                                       -fx-focus-color:transparent;-fx-faint-focus-color:transparent;"/>
                </VBox>

                <!-- Filtre Date Fin -->
                <VBox spacing="3">
                    <Label text="AU"
                           style="-fx-text-fill:rgba(0,217,255,0.40);-fx-font-family:'Consolas';
                                  -fx-font-size:8px;-fx-letter-spacing:1px;"/>
                    <DatePicker fx:id="filterDateFin"
                                prefWidth="138"
                                promptText="Date fin"
                                style="-fx-background-color:#0A1A0D;
                                       -fx-border-color:rgba(0,217,255,0.22);-fx-border-width:1;
                                       -fx-border-radius:9;-fx-background-radius:9;
                                       -fx-focus-color:transparent;-fx-faint-focus-color:transparent;"/>
                </VBox>

                <!-- Bouton Reset -->
                <VBox spacing="3">
                    <Label text=" " style="-fx-font-size:8px;"/>
                    <Button fx:id="btnReset" text="↺  Reset"
                            style="-fx-background-color:rgba(255,75,110,0.12);
                                   -fx-text-fill:#FF4B6E;-fx-font-family:'Consolas';
                                   -fx-font-size:11px;-fx-font-weight:bold;
                                   -fx-border-color:rgba(255,75,110,0.30);-fx-border-width:1;
                                   -fx-border-radius:9;-fx-background-radius:9;
                                   -fx-padding:7 14;-fx-cursor:hand;"/>
                </VBox>

            </HBox>
        </VBox>
    </top>

    <!-- ══════════════ CENTER ══════════════ -->
    <center>
        <HBox style="-fx-background-color: #050C07;">

            <!-- ── LEFT : Liste transactions ── -->
            <VBox spacing="10" HBox.hgrow="ALWAYS"
                  style="-fx-padding: 18 16 18 24;
                         -fx-border-color: transparent rgba(0,217,255,0.07) transparent transparent;
                         -fx-border-width: 0 1 0 0;">

                <!-- En-têtes colonnes -->
                <HBox style="-fx-padding: 2 8 6 8;">
                    <Label text="RÉFÉRENCE" prefWidth="165"
                           style="-fx-text-fill:rgba(0,217,255,0.35);-fx-font-family:'Consolas';
                                  -fx-font-size:9px;-fx-letter-spacing:2px;"/>
                    <Label text="MONTANT" prefWidth="105"
                           style="-fx-text-fill:rgba(0,217,255,0.35);-fx-font-family:'Consolas';
                                  -fx-font-size:9px;-fx-letter-spacing:2px;"/>
                    <Label text="MÉTHODE" prefWidth="105"
                           style="-fx-text-fill:rgba(0,217,255,0.35);-fx-font-family:'Consolas';
                                  -fx-font-size:9px;-fx-letter-spacing:2px;"/>
                    <Label text="STATUT" prefWidth="105"
                           style="-fx-text-fill:rgba(0,217,255,0.35);-fx-font-family:'Consolas';
                                  -fx-font-size:9px;-fx-letter-spacing:2px;"/>
                    <Label text="DATE" prefWidth="100"
                           style="-fx-text-fill:rgba(0,217,255,0.35);-fx-font-family:'Consolas';
                                  -fx-font-size:9px;-fx-letter-spacing:2px;"/>
                    <Label text="ACTIONS"
                           style="-fx-text-fill:rgba(0,217,255,0.35);-fx-font-family:'Consolas';
                                  -fx-font-size:9px;-fx-letter-spacing:2px;"/>
                </HBox>

                <Region prefHeight="1" maxWidth="Infinity"
                        style="-fx-background-color:rgba(0,217,255,0.09);">
                    <VBox.margin><Insets left="0" right="8"/></VBox.margin>
                </Region>

                <!-- Cards dynamiques -->
                <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                            style="-fx-background:transparent;-fx-background-color:transparent;
                                   -fx-border-color:transparent;-fx-focus-color:transparent;">
                    <VBox fx:id="cardContainer" spacing="7"
                          style="-fx-padding:2 4 4 0;-fx-background-color:transparent;"/>
                </ScrollPane>

            </VBox>

            <!-- ── RIGHT : Analytics ── -->
            <VBox spacing="14" prefWidth="340"
                  style="-fx-padding: 18 24 18 16;-fx-background-color:#060F09;">

                <Label text="◈  ANALYTICS"
                       style="-fx-text-fill:rgba(0,217,255,0.45);-fx-font-family:'Consolas';
                              -fx-font-size:10px;-fx-letter-spacing:3px;"/>

                <!-- Graphique bar mensuel -->
                <Label text="Revenus mensuels"
                       style="-fx-text-fill:#E8FFF0;-fx-font-family:'Consolas';
                              -fx-font-size:13px;-fx-font-weight:bold;"/>

                <BarChart fx:id="chart" prefHeight="200" legendVisible="false"
                          style="-fx-background-color:transparent;
                                 -fx-plot-background-color:transparent;
                                 -fx-alternative-row-fill-visible:false;
                                 -fx-vertical-grid-lines-visible:false;
                                 -fx-horizontal-grid-lines-visible:true;">
                    <xAxis>
                        <CategoryAxis style="-fx-tick-label-fill:rgba(0,217,255,0.50);
                                            -fx-font-family:'Consolas';-fx-font-size:10px;"/>
                    </xAxis>
                    <yAxis>
                        <NumberAxis style="-fx-tick-label-fill:rgba(0,217,255,0.50);
                                          -fx-font-family:'Consolas';-fx-font-size:10px;"/>
                    </yAxis>
                </BarChart>

                <!-- Légende bar -->
                <HBox spacing="16" alignment="CENTER">
                    <HBox spacing="6" alignment="CENTER_LEFT">
                        <Rectangle width="8" height="8" arcWidth="2" arcHeight="2"
                                   style="-fx-fill:#00FF88;"/>
                        <Label text="Réussis"
                               style="-fx-text-fill:rgba(200,255,220,0.50);
                                      -fx-font-family:'Consolas';-fx-font-size:10px;"/>
                    </HBox>
                    <HBox spacing="6" alignment="CENTER_LEFT">
                        <Rectangle width="8" height="8" arcWidth="2" arcHeight="2"
                                   style="-fx-fill:#FF4B6E;"/>
                        <Label text="Échoués"
                               style="-fx-text-fill:rgba(200,255,220,0.50);
                                      -fx-font-family:'Consolas';-fx-font-size:10px;"/>
                    </HBox>
                </HBox>

                <!-- Séparateur -->
                <Region prefHeight="1" maxWidth="Infinity"
                        style="-fx-background-color:rgba(0,217,255,0.10);"/>

                <!-- ✅ Camembert par méthode (NOUVEAU) -->
                <Label text="Répartition par méthode"
                       style="-fx-text-fill:#E8FFF0;-fx-font-family:'Consolas';
                              -fx-font-size:13px;-fx-font-weight:bold;"/>

                <PieChart fx:id="pieChart"
                          prefHeight="200"
                          legendVisible="true"
                          legendSide="BOTTOM"
                          labelsVisible="true"
                          style="-fx-background-color:transparent;
                                 -fx-pie-label-fill:rgba(200,255,220,0.70);"/>

            </VBox>

        </HBox>
    </center>

</BorderPane>
