<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.geometry.*?>

<AnchorPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="controllers.DashboardController"
            stylesheets="@../style/dashboard.css"
            prefWidth="1280" prefHeight="760"
            style="-fx-background-color: #050C07;">

    <HBox AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0"
          AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">

        <!-- ══════════════════════════════════════════════
             SIDEBAR
             ══════════════════════════════════════════════ -->
        <VBox fx:id="sidebar" styleClass="sidebar" prefWidth="258"
              alignment="TOP_CENTER" VBox.vgrow="ALWAYS">

            <!-- Logo block (populated dynamically by controller) -->
            <!-- Nav section label -->
            <Label text="NAVIGATION" styleClass="nav-section-label">
                <VBox.margin><Insets top="24" left="20" bottom="4"/></VBox.margin>
            </Label>

            <!-- Tableau de bord -->
            <Button text="⚡   Tableau de bord" styleClass="menu-btn" maxWidth="Infinity"/>

            <!-- Événements -->
            <Button fx:id="btnEvenements" text="🗓   Événements"
                    styleClass="menu-btn" maxWidth="Infinity"/>
            <VBox fx:id="evenementSubMenu" spacing="2" visible="false" managed="false"
                  styleClass="submenu-box">
                <Button fx:id="btnAjouterEvenement"  text="     ➕  Ajouter"
                        maxWidth="Infinity" styleClass="sub-btn"/>
                <Button fx:id="btnAfficherEvenements" text="     📋  Afficher"
                        maxWidth="Infinity" styleClass="sub-btn"/>
            </VBox>

            <!-- Congés -->
            <Button fx:id="btnConges" text="🏖   Consultation"
                    styleClass="menu-btn" maxWidth="Infinity"/>
            <VBox fx:id="congeSubMenu" spacing="2" visible="false" managed="false"
                  styleClass="submenu-box">
                <Button fx:id="btnAjouterConge"  text="     ➕  Ajouter"
                        maxWidth="Infinity" styleClass="sub-btn"/>
                <Button fx:id="btnAfficherConge" text="     📋  Afficher"
                        maxWidth="Infinity" styleClass="sub-btn"/>
            </VBox>

            <!-- Other nav items -->
            <Label text="MODULES" styleClass="nav-section-label">
                <VBox.margin><Insets top="16" left="20" bottom="4"/></VBox.margin>
            </Label>

            <Button text="🧑   Consultation"  styleClass="menu-btn" maxWidth="Infinity"/>
            <Button text="💡   Développement" styleClass="menu-btn" maxWidth="Infinity"/>
            <Button text="🧠   Psychologue"   styleClass="menu-btn" maxWidth="Infinity"/>
            <Button text="💳   Paiement"      styleClass="menu-btn" maxWidth="Infinity"/>

            <!-- Spacer -->
            <Region VBox.vgrow="ALWAYS"/>

            <!-- Divider -->
            <Line styleClass="sidebar-divider" endX="218"/>

            <!-- Front Office at bottom -->
            <Button fx:id="btnFront" text="🌐   Front Office"
                    styleClass="menu-btn-front" maxWidth="Infinity">
                <VBox.margin><Insets bottom="16" left="12" right="12"/></VBox.margin>
            </Button>

        </VBox>

        <!-- ══════════════════════════════════════════════
             MAIN AREA
             ══════════════════════════════════════════════ -->
        <VBox HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS" spacing="0">

            <!-- TOP BAR -->
            <HBox styleClass="topbar" alignment="CENTER_LEFT" spacing="14">
                <padding><Insets top="0" right="24" bottom="0" left="24"/></padding>

                <!-- Breadcrumb -->
                <Label text="⚡" style="-fx-text-fill: #00D9FF; -fx-font-size: 14px;"/>
                <Label text="/" style="-fx-text-fill: rgba(0,217,255,0.25); -fx-font-size: 13px;"/>
                <Label text="Dashboard" styleClass="breadcrumb-active"/>

                <Region HBox.hgrow="ALWAYS"/>

                <!-- Search -->
                <HBox styleClass="search-box" alignment="CENTER_LEFT" spacing="8">
                    <Label text="⌕" style="-fx-text-fill: rgba(0,217,255,0.45); -fx-font-size: 15px;"/>
                    <TextField promptText="Rechercher…" styleClass="search-field"/>
                </HBox>

                <!-- Notif bell -->
                <StackPane styleClass="notif-btn">
                    <Label text="🔔" style="-fx-font-size: 16px;"/>
                    <Circle radius="5" fill="#FF4D6D"
                            StackPane.alignment="TOP_RIGHT"
                            translateX="2" translateY="-2"/>
                </StackPane>

                <!-- Avatar -->
                <StackPane styleClass="avatar-circle">
                    <Label text="A" styleClass="avatar-label"/>
                </StackPane>
            </HBox>

            <!-- CONTENT PANE -->
            <StackPane fx:id="contentPane" styleClass="content-pane" VBox.vgrow="ALWAYS">
                <padding><Insets top="0" right="0" bottom="0" left="0"/></padding>
            </StackPane>

        </VBox>
    </HBox>
</AnchorPane>
