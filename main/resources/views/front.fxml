<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.Rectangle?>

<ScrollPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="controllers.FrontController"
            fitToWidth="true"
            stylesheets="@/style/front.css">

    <VBox spacing="0" styleClass="main-container">

        <!-- Modern Navbar -->
        <HBox styleClass="navbar" alignment="CENTER_LEFT" spacing="30">
            <!-- Logo Section -->
            <HBox spacing="12" alignment="CENTER" styleClass="logo-container">
                <ImageView fitWidth="50" fitHeight="50" preserveRatio="true">
                    <image><Image url="@/images/logo.png"/></image>
                </ImageView>
                <Label text="neurowell" styleClass="logo-text"/>
            </HBox>

            <Region HBox.hgrow="ALWAYS"/>

            <!-- Navigation Buttons -->
            <HBox spacing="20" alignment="CENTER">
                <Button text="Accueil"      styleClass="nav-btn" fx:id="btnHome"/>
                <Button text="Services"     styleClass="nav-btn" fx:id="btnServices"/>
                <Button text="Methode"      styleClass="nav-btn" fx:id="btnMethode"/>
                <Button text="Evenements"   styleClass="nav-btn" fx:id="btnEvents"       onAction="#handleEvents"/>
                <Button text="Evaluations"  styleClass="nav-btn" fx:id="btnEvaluations"  onAction="#handleEvaluations"/>
                <Button text="Ressources"   styleClass="nav-btn"                         onAction="#handleRessources"/>
                <Button text="Blog"         styleClass="nav-btn" fx:id="btnBlog"/>
            </HBox>

            <!-- ══ CONSULTATION BUTTONS (dans la navbar) ══ -->
            <!-- Bouton user : visible par defaut, masque si psy/admin via controller -->
            <Button fx:id="btnConsultation" text="Consulter un psy"
                    onAction="#handleDemandeConsultation"
                    style="-fx-background-color: linear-gradient(to right, #00D9FF, #00FF88);
                           -fx-text-fill: #050C07; -fx-font-size: 12px; -fx-font-weight: bold;
                           -fx-padding: 9 18; -fx-background-radius: 20; -fx-cursor: hand;"/>
            <!-- Bouton psy : masque par defaut, affiche si psy via controller -->
            <Button fx:id="btnEspacePsy" text="Espace Psy"
                    onAction="#handleEspacePsy"
                    visible="false" managed="false"
                    style="-fx-background-color: transparent;
                           -fx-text-fill: #00D9FF; -fx-font-size: 12px; -fx-font-weight: bold;
                           -fx-padding: 9 18; -fx-border-color: #00D9FF; -fx-border-width: 1.5;
                           -fx-border-radius: 20; -fx-background-radius: 20; -fx-cursor: hand;"/>

            <!-- Admin Button -->
            <Button text="Admin" styleClass="nav-cta-btn" fx:id="btnAdmin" onAction="#handleBackToAdmin"
                    style="-fx-background-color: rgba(0,217,255,0.15); -fx-border-color: #00D9FF;
                           -fx-border-width: 1; -fx-border-radius: 20; -fx-background-radius: 20;
                           -fx-text-fill: #00D9FF; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 8 20;"/>

            <!-- CTA Button -->
            <Button text="Contact" styleClass="nav-cta-btn" fx:id="btnContact" onAction="#handleContact"/>
        </HBox>

        <!-- Hero Section -->
        <StackPane styleClass="hero-section" prefHeight="600">
            <ImageView fx:id="heroImage" fitWidth="1400" fitHeight="600" preserveRatio="false">
                <image><Image url="@/images/1.jpg"/></image>
            </ImageView>
            <Rectangle width="1400" height="600" styleClass="hero-overlay"/>
            <VBox alignment="CENTER" spacing="25" styleClass="hero-content">
                <Label fx:id="heroTitle" styleClass="hero-title"
                       text="Transformez votre mental en superpouvoir"/>
                <Label fx:id="heroSubtitle" styleClass="hero-subtitle"
                       text="Une approche innovante qui fusionne neurosciences, psychologie positive&#10;et technologies pour debloquer votre plein potentiel mental"
                       wrapText="true"/>
                <HBox spacing="20" alignment="CENTER">
                    <Button text="Commencer maintenant" styleClass="hero-btn-primary" fx:id="btnGetStarted"/>
                    <Button text="Explorer" styleClass="hero-btn-secondary" fx:id="btnExplore"/>
                </HBox>
                <HBox spacing="30" alignment="CENTER" styleClass="floating-cards-container">
                    <VBox spacing="12" styleClass="floating-card" alignment="CENTER_LEFT">
                        <Label text="&#129504;" styleClass="card-emoji"/>
                        <Label text="Neuroplasticite" styleClass="card-title"/>
                        <Label text="Reprogrammez votre cerveau" styleClass="card-description"/>
                    </VBox>
                    <VBox spacing="12" styleClass="floating-card" alignment="CENTER_LEFT">
                        <Label text="&#9889;" styleClass="card-emoji"/>
                        <Label text="Performance" styleClass="card-title"/>
                        <Label text="Atteignez vos objectifs" styleClass="card-description"/>
                    </VBox>
                    <VBox spacing="12" styleClass="floating-card" alignment="CENTER_LEFT">
                        <Label text="&#10024;" styleClass="card-emoji"/>
                        <Label text="Bien-etre" styleClass="card-title"/>
                        <Label text="Equilibre et serenite" styleClass="card-description"/>
                    </VBox>
                </HBox>
            </VBox>
        </StackPane>

        <!-- ══ CONSULTATION TEASER SECTION ══ -->
        <HBox spacing="0" styleClass="services-section" alignment="CENTER">
            <VBox spacing="30" alignment="CENTER" HBox.hgrow="ALWAYS">
                <Label text="CONSULTATIONS" styleClass="section-tag"/>
                <Label text="Parlez a un psychologue qualifie" styleClass="section-title" wrapText="true"/>
                <Label text="Choisissez parmi nos psychologues certifies et reservez&#10;une consultation en ligne ou en presentiel."
                       styleClass="section-subtitle" wrapText="true"/>
                <HBox spacing="20" alignment="CENTER">
                    <VBox spacing="8" alignment="CENTER"
                          style="-fx-background-color: rgba(26,26,36,0.6); -fx-background-radius: 16;
                                 -fx-padding: 20 30; -fx-border-color: rgba(0,217,255,0.20);
                                 -fx-border-width: 1; -fx-border-radius: 16;">
                        <Label text="&#128100;" style="-fx-font-size: 28px;"/>
                        <Label text="Psychologues" style="-fx-text-fill: #00D9FF; -fx-font-size: 14px; -fx-font-weight: bold;"/>
                    </VBox>
                    <VBox spacing="8" alignment="CENTER"
                          style="-fx-background-color: rgba(26,26,36,0.6); -fx-background-radius: 16;
                                 -fx-padding: 20 30; -fx-border-color: rgba(0,255,136,0.20);
                                 -fx-border-width: 1; -fx-border-radius: 16;">
                        <Label text="&#128222;" style="-fx-font-size: 28px;"/>
                        <Label text="En ligne" style="-fx-text-fill: #00FF88; -fx-font-size: 14px; -fx-font-weight: bold;"/>
                    </VBox>
                    <VBox spacing="8" alignment="CENTER"
                          style="-fx-background-color: rgba(26,26,36,0.6); -fx-background-radius: 16;
                                 -fx-padding: 20 30; -fx-border-color: rgba(0,217,255,0.20);
                                 -fx-border-width: 1; -fx-border-radius: 16;">
                        <Label text="&#127968;" style="-fx-font-size: 28px;"/>
                        <Label text="Presentiel" style="-fx-text-fill: #00D9FF; -fx-font-size: 14px; -fx-font-weight: bold;"/>
                    </VBox>
                    <VBox spacing="8" alignment="CENTER"
                          style="-fx-background-color: rgba(26,26,36,0.6); -fx-background-radius: 16;
                                 -fx-padding: 20 30; -fx-border-color: rgba(0,255,136,0.20);
                                 -fx-border-width: 1; -fx-border-radius: 16;">
                        <Label text="&#128203;" style="-fx-font-size: 28px;"/>
                        <Label text="Suivi" style="-fx-text-fill: #00FF88; -fx-font-size: 14px; -fx-font-weight: bold;"/>
                    </VBox>
                </HBox>
                <Button text="Prendre rendez-vous" onAction="#handleDemandeConsultation"
                        style="-fx-background-color: linear-gradient(to right, #00D9FF, #00FF88);
                               -fx-text-fill: #050C07; -fx-font-size: 14px; -fx-font-weight: bold;
                               -fx-padding: 13 30; -fx-background-radius: 25; -fx-cursor: hand;"/>
            </VBox>
        </HBox>

        <!-- EVALUATION TEASER SECTION -->
        <HBox spacing="0" styleClass="services-section" alignment="CENTER">
            <VBox spacing="30" alignment="CENTER" HBox.hgrow="ALWAYS">
                <Label text="EVALUATIONS" styleClass="section-tag"/>
                <Label text="Comprenez votre etat mental" styleClass="section-title" wrapText="true"/>
                <Label text="Nos outils d'evaluation psychologique vous permettent de mesurer&#10;votre niveau de stress, d'anxiete et de bien-etre en quelques minutes."
                       styleClass="section-subtitle" wrapText="true"/>
                <HBox spacing="20" alignment="CENTER">
                    <VBox spacing="8" alignment="CENTER"
                          style="-fx-background-color: rgba(26,26,36,0.6); -fx-background-radius: 16;
                                 -fx-padding: 20 30; -fx-border-color: rgba(0,240,255,0.15);
                                 -fx-border-width: 1; -fx-border-radius: 16;">
                        <Label text="&#129472;" style="-fx-font-size: 28px;"/>
                        <Label text="Stress" style="-fx-text-fill: #00F0FF; -fx-font-size: 14px; -fx-font-weight: bold;"/>
                    </VBox>
                    <VBox spacing="8" alignment="CENTER"
                          style="-fx-background-color: rgba(26,26,36,0.6); -fx-background-radius: 16;
                                 -fx-padding: 20 30; -fx-border-color: rgba(0,240,255,0.15);
                                 -fx-border-width: 1; -fx-border-radius: 16;">
                        <Label text="&#128550;" style="-fx-font-size: 28px;"/>
                        <Label text="Anxiete" style="-fx-text-fill: #00c853; -fx-font-size: 14px; -fx-font-weight: bold;"/>
                    </VBox>
                    <VBox spacing="8" alignment="CENTER"
                          style="-fx-background-color: rgba(26,26,36,0.6); -fx-background-radius: 16;
                                 -fx-padding: 20 30; -fx-border-color: rgba(0,240,255,0.15);
                                 -fx-border-width: 1; -fx-border-radius: 16;">
                        <Label text="&#9889;" style="-fx-font-size: 28px;"/>
                        <Label text="Burnout" style="-fx-text-fill: #FFD700; -fx-font-size: 14px; -fx-font-weight: bold;"/>
                    </VBox>
                    <VBox spacing="8" alignment="CENTER"
                          style="-fx-background-color: rgba(26,26,36,0.6); -fx-background-radius: 16;
                                 -fx-padding: 20 30; -fx-border-color: rgba(0,240,255,0.15);
                                 -fx-border-width: 1; -fx-border-radius: 16;">
                        <Label text="&#127807;" style="-fx-font-size: 28px;"/>
                        <Label text="Bien-etre" style="-fx-text-fill: #84CC16; -fx-font-size: 14px; -fx-font-weight: bold;"/>
                    </VBox>
                </HBox>
                <Button text="Voir toutes les evaluations" onAction="#handleEvaluations"
                        styleClass="hero-btn-primary"/>
            </VBox>
        </HBox>

        <!-- RESSOURCES TEASER SECTION -->
        <HBox spacing="0" styleClass="services-section" alignment="CENTER">
            <VBox spacing="30" alignment="CENTER" HBox.hgrow="ALWAYS">
                <Label text="RESSOURCES" styleClass="section-tag"/>
                <Label text="Votre bibliotheque de developpement" styleClass="section-title" wrapText="true"/>
                <Label text="PDF, videos, articles et supports audio soigneusement selectionnes&#10;pour accompagner votre progression a votre rythme."
                       styleClass="section-subtitle" wrapText="true"/>
                <HBox spacing="20" alignment="CENTER">
                    <VBox spacing="8" alignment="CENTER"
                          style="-fx-background-color: rgba(26,26,36,0.6); -fx-background-radius: 16;
                                 -fx-padding: 20 30; -fx-border-color: rgba(245,158,11,0.25);
                                 -fx-border-width: 1; -fx-border-radius: 16;">
                        <Label text="&#128213;" style="-fx-font-size: 28px;"/>
                        <Label text="PDF" style="-fx-text-fill: #F59E0B; -fx-font-size: 14px; -fx-font-weight: bold;"/>
                    </VBox>
                    <VBox spacing="8" alignment="CENTER"
                          style="-fx-background-color: rgba(26,26,36,0.6); -fx-background-radius: 16;
                                 -fx-padding: 20 30; -fx-border-color: rgba(245,158,11,0.25);
                                 -fx-border-width: 1; -fx-border-radius: 16;">
                        <Label text="&#127909;" style="-fx-font-size: 28px;"/>
                        <Label text="Videos" style="-fx-text-fill: #F59E0B; -fx-font-size: 14px; -fx-font-weight: bold;"/>
                    </VBox>
                    <VBox spacing="8" alignment="CENTER"
                          style="-fx-background-color: rgba(26,26,36,0.6); -fx-background-radius: 16;
                                 -fx-padding: 20 30; -fx-border-color: rgba(245,158,11,0.25);
                                 -fx-border-width: 1; -fx-border-radius: 16;">
                        <Label text="&#128221;" style="-fx-font-size: 28px;"/>
                        <Label text="Articles" style="-fx-text-fill: #F59E0B; -fx-font-size: 14px; -fx-font-weight: bold;"/>
                    </VBox>
                    <VBox spacing="8" alignment="CENTER"
                          style="-fx-background-color: rgba(26,26,36,0.6); -fx-background-radius: 16;
                                 -fx-padding: 20 30; -fx-border-color: rgba(245,158,11,0.25);
                                 -fx-border-width: 1; -fx-border-radius: 16;">
                        <Label text="&#127925;" style="-fx-font-size: 28px;"/>
                        <Label text="Audio" style="-fx-text-fill: #F59E0B; -fx-font-size: 14px; -fx-font-weight: bold;"/>
                    </VBox>
                </HBox>
                <Button text="Acceder a la bibliotheque" onAction="#handleRessources"
                        styleClass="hero-btn-primary"/>
            </VBox>
        </HBox>

        <!-- About Section -->
        <HBox spacing="50" styleClass="about-section" alignment="CENTER">
            <ImageView fx:id="aboutImage" fitWidth="500" fitHeight="400" preserveRatio="true" styleClass="about-image">
                <image><Image url="@/images/2.jpeg"/></image>
            </ImageView>
            <VBox spacing="20" styleClass="about-content" prefWidth="550">
                <Label text="A PROPOS" styleClass="section-tag"/>
                <Label text="Une approche humaniste&#10;et bienveillante" styleClass="section-title" wrapText="true"/>
                <TabPane styleClass="about-tabs" prefWidth="550">
                    <tabs>
                        <Tab text="Mission" closable="false" styleClass="custom-tab">
                            <content>
                                <VBox spacing="15" styleClass="tab-content">
                                    <Label text="Notre pratique s'appuie sur des methodes eprouvees en psychologie et developpement personnel, dans le respect de votre rythme et de votre singularite."
                                           wrapText="true" styleClass="tab-text"/>
                                </VBox>
                            </content>
                        </Tab>
                        <Tab text="Vision" closable="false" styleClass="custom-tab">
                            <content>
                                <VBox spacing="15" styleClass="tab-content">
                                    <Label text="Nous croyons en votre capacite de croissance et de transformation. Notre role est de vous accompagner avec empathie et professionnalisme."
                                           wrapText="true" styleClass="tab-text"/>
                                </VBox>
                            </content>
                        </Tab>
                        <Tab text="Valeurs" closable="false" styleClass="custom-tab">
                            <content>
                                <VBox spacing="15" styleClass="tab-content">
                                    <Label text="Bienveillance, ecoute active, apprentissage continu et empowerment personnel sont au coeur de notre approche."
                                           wrapText="true" styleClass="tab-text"/>
                                </VBox>
                            </content>
                        </Tab>
                    </tabs>
                </TabPane>
                <HBox spacing="25" alignment="CENTER_LEFT" styleClass="stats-container">
                    <VBox alignment="CENTER" styleClass="stat-item">
                        <Label text="10+" styleClass="stat-number"/>
                        <Label text="ANNEES" styleClass="stat-label"/>
                    </VBox>
                    <VBox alignment="CENTER" styleClass="stat-item">
                        <Label text="500+" styleClass="stat-number"/>
                        <Label text="CLIENTS" styleClass="stat-label"/>
                    </VBox>
                </HBox>
            </VBox>
        </HBox>

        <!-- Global Stats Section -->
        <HBox spacing="50" styleClass="global-stats-section" alignment="CENTER">
            <VBox alignment="CENTER" styleClass="global-stat-card">
                <Label text="2K+" styleClass="global-stat-number"/>
                <Label text="CLIENTS TRANSFORMES" styleClass="global-stat-label"/>
            </VBox>
            <VBox alignment="CENTER" styleClass="global-stat-card">
                <Label text="94%" styleClass="global-stat-number"/>
                <Label text="TAUX DE REUSSITE" styleClass="global-stat-label"/>
            </VBox>
            <VBox alignment="CENTER" styleClass="global-stat-card">
                <Label text="15+" styleClass="global-stat-number"/>
                <Label text="ANNEES D'EXPERTISE" styleClass="global-stat-label"/>
            </VBox>
            <VBox alignment="CENTER" styleClass="global-stat-card">
                <Label text="4.9/5" styleClass="global-stat-number"/>
                <Label text="SATISFACTION" styleClass="global-stat-label"/>
            </VBox>
        </HBox>

        <!-- Footer Section -->
        <HBox spacing="60" styleClass="footer-section" alignment="TOP_LEFT">
            <VBox spacing="15" styleClass="footer-column">
                <Label text="neurowell" styleClass="footer-brand"/>
                <Label text="Pionnier de la transformation mentale." styleClass="footer-description" wrapText="true"/>
                <VBox spacing="8">
                    <Label text="71 Rue Lafayette Decarlo" styleClass="footer-text"/>
                    <Label text="Cite Chaker, Tunisie" styleClass="footer-text"/>
                    <Label text="+216 27003897" styleClass="footer-text"/>
                    <Label text="contact@neurowell.tn" styleClass="footer-text"/>
                </VBox>
            </VBox>
            <VBox spacing="15" styleClass="footer-column">
                <Label text="Navigation" styleClass="footer-heading"/>
                <Label text="Accueil"    styleClass="footer-link" fx:id="footerHome"/>
                <Label text="Services"   styleClass="footer-link" fx:id="footerServices"/>
                <Label text="Methode"    styleClass="footer-link" fx:id="footerMethode"/>
                <Label text="Blog"       styleClass="footer-link" fx:id="footerBlog"/>
            </VBox>
            <VBox spacing="15" styleClass="footer-column">
                <Label text="Services" styleClass="footer-heading"/>
                <Label text="Coaching Mental"    styleClass="footer-link"/>
                <Label text="Therapie Innovante" styleClass="footer-link"/>
                <Label text="Peak Performance"   styleClass="footer-link"/>
                <Label text="Evaluations"        styleClass="footer-link"/>
            </VBox>
            <VBox spacing="15" styleClass="footer-column">
                <Label text="Newsletter" styleClass="footer-heading"/>
                <Label text="Restez informe de nos actualites" styleClass="footer-description" wrapText="true"/>
                <TextField fx:id="newsletterEmail" promptText="Votre email" styleClass="newsletter-input"/>
                <Button text="S'abonner" styleClass="newsletter-btn" fx:id="btnNewsletter" onAction="#handleNewsletter"/>
            </VBox>
        </HBox>

        <!-- Copyright Bar -->
        <HBox styleClass="copyright-bar" alignment="CENTER">
            <Label text="© 2026 neurowell. Tous droits reserves." styleClass="copyright-text"/>
        </HBox>

    </VBox>
</ScrollPane>
