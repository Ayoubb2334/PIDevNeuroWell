<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>

<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="controllers.ParticipationController"
           stylesheets="@../style/participation.css"
           styleClass="root-container">

    <!-- Animated Background Layer -->
    <Pane styleClass="background-layer">
        <Circle fx:id="orb1" radius="250" styleClass="orb, orb-1"/>
        <Circle fx:id="orb2" radius="200" styleClass="orb, orb-2"/>
        <Circle fx:id="orb3" radius="220" styleClass="orb, orb-3"/>
    </Pane>

    <!-- Main Content -->
    <VBox fx:id="mainAnchorPane" spacing="0" styleClass="main-container">

        <!-- Modern Navbar -->
        <HBox styleClass="navbar" alignment="CENTER_LEFT" spacing="30">
            <HBox spacing="12" alignment="CENTER" styleClass="logo-container">
                <Label text="🧠" styleClass="logo-icon"/>
                <Label text="NeuroWell" styleClass="logo-text"/>
            </HBox>
            <Region HBox.hgrow="ALWAYS"/>
            <HBox spacing="25" alignment="CENTER">
                <Button text="Accueil"       styleClass="nav-btn"             onAction="#handleBackToFront"/>
                <Button text="Services"      styleClass="nav-btn"/>
                <Button text="Événements"    styleClass="nav-btn"             onAction="#handleEvenement"/>
                <Button text="Participations" styleClass="nav-btn, nav-btn-active"/>
            </HBox>
            <HBox spacing="15" alignment="CENTER">
                <Button text="Retour"  styleClass="nav-cta-btn-secondary" onAction="#handleBackToFront"/>
                <Button text="Contact" styleClass="nav-cta-btn"/>
            </HBox>
        </HBox>

        <!-- Body : liste à gauche + panneau IA à droite -->
        <HBox spacing="20" VBox.vgrow="ALWAYS">

            <!-- ═══ COLONNE GAUCHE : participations ═══ -->
            <ScrollPane fitToWidth="true" styleClass="content-scroll" HBox.hgrow="ALWAYS">
                <VBox spacing="40" styleClass="page-content">

                    <VBox spacing="20" styleClass="hero-section" alignment="CENTER">
                        <Label text="📋" styleClass="hero-icon"/>
                        <Label text="Mes Participations" styleClass="hero-title"/>
                        <Label text="Gérez vos inscriptions aux événements et suivez vos participations"
                               styleClass="hero-subtitle" wrapText="true"/>
                    </VBox>

                    <VBox spacing="25" styleClass="filters-section">
                        <HBox spacing="15" alignment="CENTER" styleClass="search-container">
                            <TextField fx:id="searchField"
                                       promptText="🔍 Rechercher une participation..."
                                       styleClass="search-input"
                                       HBox.hgrow="ALWAYS"/>
                            <Button text="Rechercher"   styleClass="btn-search" onAction="#handleSearch"/>
                            <Button text="Réinitialiser" styleClass="btn-reset"  onAction="#resetFilters"/>
                        </HBox>
                    </VBox>

                    <VBox spacing="20" styleClass="participations-section">
                        <HBox alignment="CENTER_LEFT" spacing="15" styleClass="section-header">
                            <Label text="📌 Mes participations" styleClass="section-title"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="resultsCount" text="" styleClass="results-count"/>
                        </HBox>
                        <VBox fx:id="participationContainer" spacing="20" styleClass="participations-container"/>
                    </VBox>

                </VBox>
            </ScrollPane>

            <!-- ═══ COLONNE DROITE : panneau IA Gemini ═══ -->
            <VBox fx:id="geminiSidebar" spacing="14" prefWidth="320" minWidth="300"
                  style="-fx-background-color: rgba(13,31,18,0.75);
                         -fx-background-radius: 20;
                         -fx-border-color: rgba(176,102,255,0.35);
                         -fx-border-width: 1.5;
                         -fx-border-radius: 20;
                         -fx-padding: 20;
                         -fx-margin: 10;">

                <!-- Header IA -->
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="🤖" style="-fx-font-size: 22px;"/>
                    <VBox spacing="2">
                        <Label text="Assistant IA Gemini"
                               style="-fx-text-fill: #B066FF; -fx-font-size: 14px; -fx-font-weight: bold;"/>
                        <HBox spacing="6" alignment="CENTER_LEFT">
                            <Circle fx:id="aiStatusDot" radius="5" fill="#00FF88"/>
                            <Label fx:id="lblAiStatus" text="IA Gemini prete"
                                   style="-fx-text-fill: #00FF88; -fx-font-size: 10px;"/>
                        </HBox>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <ProgressIndicator fx:id="aiLoader" prefWidth="22" prefHeight="22"
                                       visible="false"
                                       style="-fx-accent: #B066FF;"/>
                </HBox>

                <Separator style="-fx-background-color: rgba(176,102,255,0.25);"/>

                <!-- Boutons IA -->
                <VBox spacing="8">
                    <Button fx:id="btnAnalyseSentiment" maxWidth="Infinity"
                            onAction="#handleAnalyseSentiment"/>
                    <Button fx:id="btnRecommandations"  maxWidth="Infinity"
                            onAction="#handleRecommandations"/>
                    <Button fx:id="btnResume"           maxWidth="Infinity"
                            onAction="#handleResume"/>
                    <Button fx:id="btnRisqueAbandon"    maxWidth="Infinity"
                            onAction="#handleRisqueAbandon"/>
                </VBox>

                <Separator style="-fx-background-color: rgba(176,102,255,0.20);"/>

                <Label text="Resultats IA"
                       style="-fx-text-fill: rgba(255,255,255,0.35); -fx-font-size: 10px;"/>

                <!-- Zone résultats scrollable -->
                <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                            VBox.vgrow="ALWAYS"
                            style="-fx-background: transparent; -fx-background-color: transparent;">
                    <VBox fx:id="aiResultsBox" spacing="10"/>
                </ScrollPane>

            </VBox>

        </HBox>

        <!-- Footer -->
        <HBox styleClass="footer-bar" alignment="CENTER" spacing="20">
            <Label text="© 2026 NeuroWell"         styleClass="footer-text"/>
            <Label text="•"                         styleClass="footer-separator"/>
            <Label text="Développement Personnel"   styleClass="footer-text"/>
            <Label text="•"                         styleClass="footer-separator"/>
            <Label text="Transformation Mentale"    styleClass="footer-text"/>
        </HBox>

    </VBox>
</StackPane>
