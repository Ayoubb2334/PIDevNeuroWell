<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Button?>
<?import javafx.geometry.Insets?>

<StackPane xmlns:fx="http://javafx.com/fxml/1"
           xmlns="http://javafx.com/javafx/17"
           fx:controller="controllers.AjouterPaiementController"
           style="-fx-background-color: #050C07;">

    <!-- Carte principale -->
    <VBox spacing="0"
          maxWidth="460"
          alignment="TOP_CENTER"
          style="-fx-background-color: #071A10;
                 -fx-border-color: rgba(0,217,255,0.20);
                 -fx-border-width: 1;
                 -fx-border-radius: 20;
                 -fx-background-radius: 20;">

        <!-- Header -->
        <VBox alignment="CENTER"
              spacing="5"
              style="-fx-padding: 30 40 20 40;
                     -fx-background-color: linear-gradient(to bottom, rgba(0,217,255,0.05), transparent);
                     -fx-border-color: transparent transparent rgba(0,217,255,0.08) transparent;
                     -fx-border-width: 0 0 1 0;">
            <Label text="NOUVEAU PAIEMENT"
                   style="-fx-text-fill: rgba(0,217,255,0.50);
                          -fx-font-size: 10px;
                          -fx-font-weight: bold;" />
            <Label text="Ajouter une Transaction"
                   style="-fx-text-fill: #E8FFF0;
                          -fx-font-size: 20px;
                          -fx-font-weight: bold;" />
        </VBox>

        <!-- Champs -->
        <VBox spacing="14"
              style="-fx-padding: 24 40 32 40;">

            <!-- MONTANT -->
            <VBox spacing="5">
                <Label text="MONTANT (DT)"
                       style="-fx-text-fill: rgba(0,217,255,0.55);
                              -fx-font-size: 9px;
                              -fx-font-weight: bold;" />
                <HBox alignment="CENTER_LEFT"
                      style="-fx-background-color: #0A1A0D;
                             -fx-border-color: rgba(0,217,255,0.22);
                             -fx-border-width: 1;
                             -fx-border-radius: 10;
                             -fx-background-radius: 10;">
                    <Label text="DT"
                           style="-fx-text-fill: #00FF88;
                                  -fx-font-size: 13px;
                                  -fx-font-weight: bold;
                                  -fx-padding: 0 12 0 12;
                                  -fx-border-color: transparent rgba(0,217,255,0.15) transparent transparent;
                                  -fx-border-width: 0 1 0 0;" />
                    <TextField fx:id="montantField"
                               promptText="0.00"
                               HBox.hgrow="ALWAYS"
                               style="-fx-background-color: transparent;
                                      -fx-text-fill: #E8FFF0;
                                      -fx-font-size: 15px;
                                      -fx-font-weight: bold;
                                      -fx-prompt-text-fill: rgba(200,255,220,0.20);
                                      -fx-padding: 11 14 11 14;
                                      -fx-border-color: transparent;
                                      -fx-focus-color: transparent;
                                      -fx-faint-focus-color: transparent;" />
                </HBox>
            </VBox>

            <!-- DATE -->
            <VBox spacing="5">
                <Label text="DATE DE PAIEMENT"
                       style="-fx-text-fill: rgba(0,217,255,0.55);
                              -fx-font-size: 9px;
                              -fx-font-weight: bold;" />
                <DatePicker fx:id="datePicker"
                            maxWidth="Infinity"
                            style="-fx-background-color: #0A1A0D;
                                   -fx-border-color: rgba(0,217,255,0.22);
                                   -fx-border-width: 1;
                                   -fx-border-radius: 10;
                                   -fx-background-radius: 10;
                                   -fx-focus-color: transparent;
                                   -fx-faint-focus-color: transparent;" />
            </VBox>

            <!-- MODE -->
            <VBox spacing="5">
                <Label text="MODE DE PAIEMENT"
                       style="-fx-text-fill: rgba(0,217,255,0.55);
                              -fx-font-size: 9px;
                              -fx-font-weight: bold;" />
                <ComboBox fx:id="modeCombo"
                          promptText="Sélectionner le mode..."
                          maxWidth="Infinity"
                          style="-fx-background-color: #0A1A0D;
                                 -fx-border-color: rgba(0,217,255,0.22);
                                 -fx-border-width: 1;
                                 -fx-border-radius: 10;
                                 -fx-background-radius: 10;
                                 -fx-font-size: 13px;
                                 -fx-padding: 4 10 4 10;
                                 -fx-focus-color: transparent;
                                 -fx-faint-focus-color: transparent;" />
            </VBox>

            <!-- STATUT -->
            <VBox spacing="5">
                <Label text="STATUT"
                       style="-fx-text-fill: rgba(0,217,255,0.55);
                              -fx-font-size: 9px;
                              -fx-font-weight: bold;" />
                <ComboBox fx:id="statutCombo"
                          promptText="Sélectionner le statut..."
                          maxWidth="Infinity"
                          style="-fx-background-color: #0A1A0D;
                                 -fx-border-color: rgba(0,217,255,0.22);
                                 -fx-border-width: 1;
                                 -fx-border-radius: 10;
                                 -fx-background-radius: 10;
                                 -fx-font-size: 13px;
                                 -fx-padding: 4 10 4 10;
                                 -fx-focus-color: transparent;
                                 -fx-faint-focus-color: transparent;" />
            </VBox>

            <!-- BTN ENREGISTRER -->
            <Button fx:id="addBtn"
                    text="ENREGISTRER LE PAIEMENT"
                    maxWidth="Infinity"
                    onAction="#handleAjouter"
                    style="-fx-background-color: linear-gradient(to right, #00c47a, #00D9FF);
                           -fx-text-fill: #050C07;
                           -fx-font-size: 13px;
                           -fx-font-weight: bold;
                           -fx-background-radius: 12;
                           -fx-border-radius: 12;
                           -fx-padding: 14 20 14 20;
                           -fx-cursor: hand;">
                <VBox.margin>
                    <Insets top="8" />
                </VBox.margin>
            </Button>

            <!-- BTN ANNULER -->
            <Button text="Annuler"
                    maxWidth="Infinity"
                    onAction="#handleAnnuler"
                    style="-fx-background-color: transparent;
                           -fx-text-fill: rgba(200,255,220,0.40);
                           -fx-font-size: 12px;
                           -fx-border-color: rgba(0,217,255,0.15);
                           -fx-border-width: 1;
                           -fx-border-radius: 12;
                           -fx-background-radius: 12;
                           -fx-padding: 10 20 10 20;
                           -fx-cursor: hand;" />

        </VBox>
    </VBox>

</StackPane>
