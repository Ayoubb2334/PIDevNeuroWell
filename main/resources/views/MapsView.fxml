<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.web.WebView?>

<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="controllers.MapsController"
           fx:id="rootPane"
           stylesheets="@../style/Maps.css"
           styleClass="root-container">

    <Pane styleClass="background-layer">
        <Circle fx:id="orb1" radius="250" styleClass="orb, orb-1"/>
        <Circle fx:id="orb2" radius="200" styleClass="orb, orb-2"/>
        <Circle fx:id="orb3" radius="220" styleClass="orb, orb-3"/>
    </Pane>

    <BorderPane styleClass="main-layout">
        <left>
            <!-- ScrollPane wrapping the sidebar so all buttons are always accessible -->
            <ScrollPane fitToWidth="true"
                        hbarPolicy="NEVER"
                        vbarPolicy="AS_NEEDED"
                        prefWidth="300"
                        styleClass="sidebar-scroll">

                <VBox styleClass="sidebar" spacing="12" prefWidth="280">
                    <padding><Insets top="15" right="18" bottom="15" left="18"/></padding>

                    <!-- Header -->
                    <VBox spacing="6" styleClass="header-section">
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Label text="🧠" styleClass="header-icon"/>
                            <VBox spacing="1">
                                <Label text="NEUROWELL" styleClass="header-title"/>
                                <Label text="Localisation" styleClass="header-subtitle"/>
                            </VBox>
                        </HBox>
                    </VBox>

                    <Separator styleClass="section-separator"/>

                    <!-- Événement -->
                    <VBox spacing="6" styleClass="info-section">
                        <Label text="📍 Événement" styleClass="section-label"/>
                        <TextField fx:id="lblEventTitle" editable="false" styleClass="info-field, info-field-title" promptText="Titre de l'événement"/>
                    </VBox>

                    <Separator styleClass="section-separator"/>

                    <!-- Adresse -->
                    <VBox spacing="6" styleClass="info-section">
                        <Label text="📌 Adresse" styleClass="section-label"/>
                        <TextArea fx:id="lblAddress" editable="false" wrapText="true" prefRowCount="2" styleClass="info-area" promptText="Adresse"/>
                    </VBox>

                    <Separator styleClass="section-separator"/>

                    <!-- Statut -->
                    <VBox spacing="6" styleClass="info-section">
                        <Label text="⚡ Statut" styleClass="section-label"/>
                        <HBox spacing="10" alignment="CENTER_LEFT" styleClass="status-container">
                            <Circle fx:id="statusDot" radius="7" styleClass="status-indicator"/>
                            <Label fx:id="lblStatus" text="Initialisation..." styleClass="status-text"/>
                        </HBox>
                    </VBox>

                    <Separator styleClass="section-separator"/>

                    <!-- Coordonnées GPS -->
                    <VBox spacing="8" styleClass="info-section">
                        <Label text="🌐 Coordonnées GPS" styleClass="section-label"/>
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <VBox spacing="3" HBox.hgrow="ALWAYS">
                                <Label text="Latitude" styleClass="coord-label"/>
                                <TextField fx:id="lblLat" editable="false" styleClass="coord-field" promptText="0.000000"/>
                            </VBox>
                            <VBox spacing="3" HBox.hgrow="ALWAYS">
                                <Label text="Longitude" styleClass="coord-label"/>
                                <TextField fx:id="lblLon" editable="false" styleClass="coord-field" promptText="0.000000"/>
                            </VBox>
                        </HBox>
                    </VBox>

                    <Separator styleClass="section-separator"/>

                    <!-- Détails -->
                    <VBox spacing="6" styleClass="info-section">
                        <Label text="ℹ️ Détails" styleClass="section-label"/>
                        <VBox spacing="5" styleClass="details-grid">
                            <HBox spacing="8" alignment="CENTER_LEFT">
                                <Label text="🗺️" styleClass="detail-icon"/>
                                <Label text="OpenStreetMap" styleClass="detail-text"/>
                            </HBox>
                            <HBox spacing="8" alignment="CENTER_LEFT">
                                <Label text="🔍" styleClass="detail-icon"/>
                                <Label text="Zoom niveau 15" styleClass="detail-text"/>
                            </HBox>
                            <HBox spacing="8" alignment="CENTER_LEFT">
                                <Label text="📡" styleClass="detail-icon"/>
                                <Label text="Carte interactive" styleClass="detail-text"/>
                            </HBox>
                        </VBox>
                    </VBox>

                    <Separator styleClass="section-separator"/>

                    <!-- Boutons d'action — toujours visibles grâce au scroll -->
                    <VBox spacing="8" styleClass="actions-section">
                        <Button text="🌍 Ouvrir dans Google Maps" fx:id="btnOpenBrowser" maxWidth="Infinity" styleClass="btn-primary"/>
                        <Button text="⬅️ Retour aux événements" fx:id="btnBack" maxWidth="Infinity" styleClass="btn-secondary"/>
                    </VBox>

                </VBox>
            </ScrollPane>
        </left>

        <center>
            <StackPane styleClass="map-container">
                <HBox spacing="10" alignment="TOP_RIGHT" StackPane.alignment="TOP_RIGHT" styleClass="map-controls">
                    <padding><Insets top="15" right="15"/></padding>
                    <VBox spacing="6">
                        <Button text="➕" fx:id="btnZoomIn" styleClass="map-control-btn"/>
                        <Button text="➖" fx:id="btnZoomOut" styleClass="map-control-btn"/>
                        <Button text="⊙" fx:id="btnCenter" styleClass="map-control-btn"/>
                    </VBox>
                </HBox>

                <HBox spacing="10" alignment="TOP_LEFT" StackPane.alignment="TOP_LEFT" styleClass="map-status-badge">
                    <padding><Insets top="15" left="15"/></padding>
                    <Label text="● CARTE EN DIRECT" styleClass="live-badge"/>
                </HBox>

                <WebView fx:id="mapView" styleClass="web-map" StackPane.alignment="CENTER"/>

                <VBox fx:id="loadingOverlay" spacing="15" alignment="CENTER" styleClass="loading-overlay">
                    <Label text="⏳" styleClass="loading-icon"/>
                    <Label text="Chargement de la carte..." styleClass="loading-text"/>
                    <ProgressBar fx:id="loadingBar" prefWidth="260" styleClass="loading-progress"/>
                </VBox>
            </StackPane>
        </center>
    </BorderPane>
</StackPane>
