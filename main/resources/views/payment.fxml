<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.web.*?>
<?import javafx.geometry.*?>

<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:id="rootPane"
           fx:controller="controllers.PaymentController"
           prefWidth="1000" prefHeight="680"
           style="-fx-background-color: #050C07;">

    <!-- ORBS BACKGROUND -->
    <Circle fx:id="orb1" radius="320"
            style="-fx-fill: radial-gradient(center 50% 50%, radius 60%, rgba(0,217,255,0.09), transparent);"
            translateX="-350" translateY="-200"/>
    <Circle fx:id="orb2" radius="240"
            style="-fx-fill: radial-gradient(center 50% 50%, radius 60%, rgba(0,255,136,0.07), transparent);"
            translateX="380" translateY="260"/>
    <Circle fx:id="orb3" radius="180"
            style="-fx-fill: radial-gradient(center 50% 50%, radius 60%, rgba(255,179,0,0.05), transparent);"
            translateX="50" translateY="-300"/>

    <HBox spacing="0">

        <!-- LEFT PANEL — Order Summary -->
        <VBox spacing="0" prefWidth="360" maxWidth="360"
              style="-fx-background-color: rgba(13,31,18,0.97);
                     -fx-border-color: transparent rgba(0,217,255,0.15) transparent transparent;
                     -fx-border-width: 0 1 0 0;">

            <!-- Header -->
            <VBox spacing="6"
                  style="-fx-padding: 28 24 20 24;
                         -fx-background-color: linear-gradient(to bottom, rgba(0,217,255,0.07), rgba(0,0,0,0));
                         -fx-border-color: transparent transparent rgba(0,217,255,0.10) transparent;
                         -fx-border-width: 0 0 1 0;">
                <HBox spacing="12" alignment="CENTER_LEFT">
                    <StackPane>
                        <Circle radius="22"
                                style="-fx-fill: rgba(0,217,255,0.10);
                                       -fx-stroke: rgba(0,217,255,0.40); -fx-stroke-width: 1.5;"/>
                        <Label text="&#128179;" style="-fx-font-size: 18px;"/>
                    </StackPane>
                    <VBox spacing="1">
                        <Label text="NEUROWELL"
                               style="-fx-text-fill: rgba(0,217,255,0.50); -fx-font-size: 9px; -fx-font-weight: bold;"/>
                        <Label text="Paiement securise"
                               style="-fx-text-fill: #E8FFF0; -fx-font-size: 18px; -fx-font-weight: bold;"/>
                    </VBox>
                </HBox>
            </VBox>

            <!-- Event card -->
            <VBox spacing="12" style="-fx-padding: 20 22;
                  -fx-border-color: transparent transparent rgba(0,217,255,0.10) transparent;
                  -fx-border-width: 0 0 1 0;">
                <Label text="Votre commande"
                       style="-fx-text-fill: rgba(0,217,255,0.55); -fx-font-size: 10px; -fx-font-weight: bold;"/>

                <HBox spacing="14" alignment="CENTER_LEFT"
                      style="-fx-background-color: rgba(0,0,0,0.35);
                             -fx-border-color: rgba(0,217,255,0.15); -fx-border-width: 1;
                             -fx-border-radius: 14; -fx-background-radius: 14; -fx-padding: 14 16;">
                    <StackPane>
                        <Circle radius="26"
                                style="-fx-fill: rgba(0,217,255,0.18);
                                       -fx-stroke: rgba(0,217,255,0.30); -fx-stroke-width: 1;"/>
                        <Label text="&#127881;" style="-fx-font-size: 22px;"/>
                    </StackPane>
                    <VBox spacing="4">
                        <Label fx:id="lblEventName" text="Evenement"
                               style="-fx-text-fill: #E8FFF0; -fx-font-size: 14px; -fx-font-weight: bold;"
                               wrapText="true" maxWidth="220"/>
                        <Label fx:id="lblEventDate" text="Date"
                               style="-fx-text-fill: rgba(200,255,220,0.50); -fx-font-size: 11px;"/>
                    </VBox>
                </HBox>
            </VBox>

            <!-- Price breakdown -->
            <VBox spacing="10" style="-fx-padding: 18 22;
                  -fx-border-color: transparent transparent rgba(0,217,255,0.10) transparent;
                  -fx-border-width: 0 0 1 0;">
                <Label text="Recapitulatif"
                       style="-fx-text-fill: rgba(0,217,255,0.55); -fx-font-size: 10px; -fx-font-weight: bold;"/>

                <HBox>
                    <Label text="Inscription"
                           style="-fx-text-fill: rgba(200,255,220,0.65); -fx-font-size: 13px;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="lblPrixBase" text="0 DT"
                           style="-fx-text-fill: #E8FFF0; -fx-font-size: 13px;"/>
                </HBox>
                <HBox>
                    <Label text="Frais de service (5%)"
                           style="-fx-text-fill: rgba(200,255,220,0.65); -fx-font-size: 13px;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="lblFrais" text="0 DT"
                           style="-fx-text-fill: rgba(200,255,220,0.55); -fx-font-size: 13px;"/>
                </HBox>

                <!-- Total -->
                <HBox style="-fx-background-color: rgba(0,217,255,0.08);
                             -fx-border-color: rgba(0,217,255,0.25); -fx-border-width: 1;
                             -fx-border-radius: 12; -fx-background-radius: 12; -fx-padding: 12 14;">
                    <Label text="Total TTC"
                           style="-fx-text-fill: #00D9FF; -fx-font-size: 14px; -fx-font-weight: bold;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="lblTotal" text="0 DT"
                           style="-fx-text-fill: #00FF88; -fx-font-size: 18px; -fx-font-weight: bold;"/>
                </HBox>
            </VBox>

            <!-- Security badges -->
            <VBox spacing="10" style="-fx-padding: 18 22;">
                <Label text="Securite"
                       style="-fx-text-fill: rgba(0,217,255,0.55); -fx-font-size: 10px; -fx-font-weight: bold;"/>
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Label text="&#128274;"
                           style="-fx-font-size: 14px;"/>
                    <Label text="Paiement SSL 256-bit"
                           style="-fx-text-fill: rgba(200,255,220,0.55); -fx-font-size: 11px;"/>
                </HBox>
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Label text="&#9989;"
                           style="-fx-font-size: 14px;"/>
                    <Label text="Donnees chiffrees Stripe"
                           style="-fx-text-fill: rgba(200,255,220,0.55); -fx-font-size: 11px;"/>
                </HBox>
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Label text="&#128200;"
                           style="-fx-font-size: 14px;"/>
                    <Label text="Confirmation instantanee"
                           style="-fx-text-fill: rgba(200,255,220,0.55); -fx-font-size: 11px;"/>
                </HBox>
            </VBox>

            <Region VBox.vgrow="ALWAYS"/>

            <!-- Back button -->
            <VBox style="-fx-padding: 16 22 24 22;
                         -fx-border-color: rgba(0,217,255,0.10) transparent transparent transparent;
                         -fx-border-width: 1 0 0 0;">
                <Button fx:id="btnBack" text="Annuler le paiement"
                        maxWidth="Infinity" onAction="#handleBack"
                        style="-fx-background-color: transparent;
                               -fx-border-color: rgba(255,77,109,0.40); -fx-border-width: 1;
                               -fx-border-radius: 14; -fx-background-radius: 14;
                               -fx-text-fill: rgba(255,77,109,0.70); -fx-font-size: 12px;
                               -fx-padding: 11 0; -fx-cursor: hand;"/>
            </VBox>
        </VBox>

        <!-- RIGHT PANEL — Payment WebView -->
        <VBox HBox.hgrow="ALWAYS">

            <!-- Top bar -->
            <HBox spacing="14" alignment="CENTER_LEFT"
                  style="-fx-background-color: rgba(5,12,7,0.90);
                         -fx-border-color: transparent transparent rgba(0,217,255,0.10) transparent;
                         -fx-border-width: 0 0 1 0; -fx-padding: 14 22;">
                <Circle radius="5"
                        style="-fx-fill: #00FF88;
                               -fx-effect: dropshadow(gaussian, rgba(0,255,136,0.9), 10, 0.6, 0, 0);"/>
                <Label text="PAIEMENT SECURISE"
                       style="-fx-text-fill: rgba(0,217,255,0.60); -fx-font-size: 10px; -fx-font-weight: bold;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="lblStatus" text="En attente..."
                       style="-fx-text-fill: rgba(200,255,220,0.45); -fx-font-size: 11px;"/>
            </HBox>

            <!-- WebView payment form -->
            <StackPane VBox.vgrow="ALWAYS">
                <WebView fx:id="paymentWebView"/>

                <!-- Loading overlay -->
                <VBox fx:id="loadingOverlay" alignment="CENTER" spacing="16"
                      style="-fx-background-color: rgba(5,12,7,0.94);">
                    <Label text="&#128179;" style="-fx-font-size: 56px;"/>
                    <Label text="Chargement du formulaire..."
                           style="-fx-text-fill: #00D9FF; -fx-font-size: 16px; -fx-font-weight: bold;"/>
                    <ProgressBar fx:id="loadingBar" prefWidth="200"
                                 style="-fx-accent: #00D9FF; -fx-background-color: rgba(0,217,255,0.12);
                                        -fx-background-radius: 8; -fx-pref-height: 5;"/>
                </VBox>
            </StackPane>
        </VBox>
    </HBox>
</StackPane>
