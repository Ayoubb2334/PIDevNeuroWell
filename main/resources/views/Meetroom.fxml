<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>

<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="controllers.MeetRoomController"
           fx:id="rootPane"
           style="-fx-background-color: #050C07;">

    <!-- Orbs décoratifs -->
    <Pane mouseTransparent="true">
        <Circle fx:id="orb1" radius="180" layoutX="80"  layoutY="120"
                fill="rgba(0,217,255,0.06)" stroke="rgba(0,217,255,0.12)" strokeWidth="1"/>
        <Circle fx:id="orb2" radius="150" layoutX="700" layoutY="80"
                fill="rgba(0,255,136,0.05)" stroke="rgba(0,255,136,0.10)" strokeWidth="1"/>
        <Circle fx:id="orb3" radius="200" layoutX="600" layoutY="500"
                fill="rgba(0,217,255,0.04)" stroke="rgba(0,217,255,0.08)" strokeWidth="1"/>
        <Circle fx:id="orb4" radius="120" layoutX="150" layoutY="450"
                fill="rgba(0,255,136,0.04)" stroke="rgba(0,255,136,0.08)" strokeWidth="1"/>
    </Pane>

    <!-- Carte principale -->
    <VBox fx:id="mainCard" spacing="0" alignment="TOP_CENTER" maxWidth="780" maxHeight="680"
          style="-fx-background-color: rgba(13,31,18,0.92);
                 -fx-background-radius: 24;
                 -fx-border-color: rgba(0,217,255,0.20);
                 -fx-border-width: 1.5;
                 -fx-border-radius: 24;
                 -fx-effect: dropshadow(gaussian, rgba(0,217,255,0.25), 40, 0, 0, 0);">

        <!-- Header -->
        <HBox alignment="CENTER_LEFT" spacing="14"
              style="-fx-background-color: rgba(0,217,255,0.06);
                     -fx-padding: 18 24;
                     -fx-border-color: transparent transparent rgba(0,217,255,0.15) transparent;
                     -fx-border-width: 0 0 1 0;">

            <Circle radius="8" style="-fx-fill: #00D9FF; -fx-effect: dropshadow(gaussian,#00D9FF,10,0.5,0,0);"/>
            <Label fx:id="lblLiveIndicator" text="● EN DIRECT"
                   style="-fx-text-fill: #00FF88; -fx-font-size: 11px; -fx-font-weight: bold;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="lblEventTitle" text="Événement"
                   style="-fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold;"/>
            <Label fx:id="lblMode" text="En ligne"
                   style="-fx-text-fill: #00D9FF; -fx-font-size: 12px;"/>
        </HBox>

        <!-- Scroll pour le contenu -->
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                    style="-fx-background: transparent; -fx-background-color: transparent;"
                    VBox.vgrow="ALWAYS">

            <VBox spacing="18" style="-fx-padding: 22 28;">

                <!-- Lien Meet -->
                <VBox spacing="8">
                    <Label text="🔗 Lien de la réunion"
                           style="-fx-text-fill: rgba(0,217,255,0.80); -fx-font-size: 12px; -fx-font-weight: bold;"/>
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label fx:id="lblMeetUrl" text="Génération en cours..."
                               style="-fx-text-fill: rgba(255,255,255,0.55); -fx-font-size: 12px;"
                               HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                        <Button fx:id="btnCopyLink" text="📋 Copier"
                                style="-fx-background-color: rgba(0,217,255,0.15);
                                       -fx-text-fill: #00D9FF; -fx-font-size: 12px;
                                       -fx-padding: 7 16; -fx-background-radius: 10; -fx-cursor: hand;
                                       -fx-border-color: rgba(0,217,255,0.30); -fx-border-width: 1; -fx-border-radius: 10;"/>
                    </HBox>
                </VBox>

                <Separator style="-fx-background-color: rgba(0,217,255,0.12);"/>

                <!-- ══ HEURE DE DÉBUT ══════════════════════════════════════ -->
                <VBox spacing="10">
                    <Label text="🕐 Heure de début"
                           style="-fx-text-fill: rgba(0,255,136,0.85); -fx-font-size: 13px; -fx-font-weight: bold;"/>

                    <HBox spacing="12" alignment="CENTER_LEFT">
                        <VBox spacing="4" alignment="CENTER">
                            <Label text="Heures" style="-fx-text-fill: rgba(255,255,255,0.50); -fx-font-size: 11px;"/>
                            <Spinner fx:id="spinnerHours" prefWidth="75" prefHeight="36"/>
                        </VBox>
                        <Label text=":" style="-fx-text-fill: #00FF88; -fx-font-size: 24px; -fx-font-weight: bold;"/>
                        <VBox spacing="4" alignment="CENTER">
                            <Label text="Minutes" style="-fx-text-fill: rgba(255,255,255,0.50); -fx-font-size: 11px;"/>
                            <Spinner fx:id="spinnerMinutes" prefWidth="75" prefHeight="36"/>
                        </VBox>
                        <Button fx:id="btnSetTime" text="✔ Définir l'heure"
                                onAction="#handleSetTime"/>
                    </HBox>

                    <!-- Countdown -->
                    <VBox spacing="4" alignment="CENTER"
                          style="-fx-background-color: rgba(0,255,136,0.06);
                                 -fx-padding: 14 20; -fx-background-radius: 14;
                                 -fx-border-color: rgba(0,255,136,0.20); -fx-border-width: 1; -fx-border-radius: 14;">
                        <Label fx:id="lblCountdown" text="--:--"
                               style="-fx-text-fill: #00FF88; -fx-font-size: 34px; -fx-font-weight: bold;"/>
                        <Label fx:id="lblCountdownSub" text="Définissez une heure ci-dessus"
                               style="-fx-text-fill: rgba(255,255,255,0.45); -fx-font-size: 12px;"/>
                    </VBox>

                    <!-- Date affichée -->
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <Label text="📅" style="-fx-font-size: 13px;"/>
                        <Label fx:id="lblDate" text="--"
                               style="-fx-text-fill: rgba(255,255,255,0.60); -fx-font-size: 13px;"/>
                    </HBox>
                </VBox>

                <Separator style="-fx-background-color: rgba(0,217,255,0.12);"/>

                <!-- ══ PARTICIPANTS ════════════════════════════════════════ -->
                <VBox spacing="12">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="✉ Inviter par email"
                               style="-fx-text-fill: rgba(0,217,255,0.85); -fx-font-size: 13px; -fx-font-weight: bold;"/>
                        <Label fx:id="lblParticipantCount" text="0 invite"
                               style="-fx-text-fill: rgba(0,217,255,0.55); -fx-font-size: 11px;
                                      -fx-background-color: rgba(0,217,255,0.10); -fx-padding: 3 10;
                                      -fx-background-radius: 10;"/>
                    </HBox>

                    <!-- Champ email + bouton ajouter -->
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <TextField fx:id="txtParticipantName"
                                   promptText="exemple@email.com"
                                   HBox.hgrow="ALWAYS"
                                   onAction="#handleAddParticipant"
                                   style="-fx-background-color: rgba(0,217,255,0.07);
                                          -fx-text-fill: white;
                                          -fx-prompt-text-fill: rgba(255,255,255,0.30);
                                          -fx-font-size: 13px; -fx-padding: 10 14;
                                          -fx-background-radius: 12;
                                          -fx-border-color: rgba(0,217,255,0.25);
                                          -fx-border-width: 1.5; -fx-border-radius: 12;"/>
                        <Button fx:id="btnAddParticipant" text="＋ Ajouter"
                                onAction="#handleAddParticipant"/>
                    </HBox>

                    <!-- Liste des emails -->
                    <VBox fx:id="participantsListBox" spacing="6"/>

                    <!-- Bouton envoyer les invitations -->
                    <Button fx:id="btnSendInvitations" text="📨 Envoyer les invitations"
                            maxWidth="Infinity" onAction="#handleSendInvitations"
                            style="-fx-background-color: linear-gradient(to right, #00FF88, #00D9FF);
                                   -fx-text-fill: #050C07; -fx-font-weight: bold;
                                   -fx-font-size: 13px; -fx-padding: 11 20;
                                   -fx-background-radius: 12; -fx-cursor: hand;"/>
                </VBox>

                <Separator style="-fx-background-color: rgba(0,217,255,0.12);"/>

                <!-- Statut -->
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Circle fx:id="statusDot" radius="6" fill="#00D9FF"/>
                    <Label fx:id="lblStatus" text="En attente..."
                           style="-fx-text-fill: #00D9FF; -fx-font-size: 11px;"/>
                </HBox>

            </VBox>
        </ScrollPane>

        <!-- Footer boutons -->
        <HBox spacing="14" alignment="CENTER"
              style="-fx-padding: 16 24;
                     -fx-border-color: rgba(0,217,255,0.15) transparent transparent transparent;
                     -fx-border-width: 1 0 0 0;">
            <Button fx:id="btnCancel" text="✕ Fermer"
                    style="-fx-background-color: transparent;
                           -fx-border-color: #FF4D6D; -fx-border-width: 1.5;
                           -fx-border-radius: 20; -fx-background-radius: 20;
                           -fx-text-fill: #FF4D6D; -fx-font-weight: bold;
                           -fx-padding: 10 24; -fx-cursor: hand;"/>
            <Button fx:id="btnJoinNow" text="🚀 Rejoindre la réunion"/>
        </HBox>

    </VBox>
</StackPane>
