<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="controllers.AfficherRessourceController"
      spacing="0"
      style="-fx-background-color: #050C07;">

    <!-- ═══════════════════════════════════════════════════
         HEADER
    ═══════════════════════════════════════════════════ -->
    <HBox alignment="CENTER_LEFT" spacing="16"
          style="-fx-background-color: #071A10;
                 -fx-border-color: rgba(0,217,255,0.15);
                 -fx-border-width: 0 0 1 0;
                 -fx-padding: 18 30;">

        <!-- Icône -->
        <StackPane style="-fx-background-color: rgba(0,217,255,0.10);
                          -fx-border-color: rgba(0,217,255,0.30);
                          -fx-border-width: 1;
                          -fx-background-radius: 8; -fx-border-radius: 8;"
                   prefWidth="44" prefHeight="44">
            <Label text="📚" style="-fx-font-size: 20px;"/>
        </StackPane>

        <VBox spacing="3">
            <Label text="Gestion des Ressources"
                   style="-fx-text-fill: #00D9FF;
                          -fx-font-size: 22px;
                          -fx-font-weight: bold;
                          -fx-font-family: 'Courier New';"/>
            <Label text="Administration · Back Office"
                   style="-fx-text-fill: rgba(0,217,255,0.40);
                          -fx-font-size: 11px;
                          -fx-font-family: 'Courier New';"/>
        </VBox>

        <Region HBox.hgrow="ALWAYS"/>

        <!-- Compteur total -->
        <StackPane style="-fx-background-color: rgba(0,217,255,0.10);
                          -fx-border-color: rgba(0,217,255,0.30);
                          -fx-border-width: 1;
                          -fx-background-radius: 12; -fx-border-radius: 12;
                          -fx-padding: 8 18;">
            <VBox alignment="CENTER" spacing="1">
                <Label text="TOTAL" style="-fx-text-fill: rgba(0,217,255,0.50); -fx-font-size: 9px; -fx-font-family: 'Courier New';"/>
                <Label fx:id="totalCount" text="0"
                       style="-fx-text-fill: #00D9FF;
                              -fx-font-size: 22px;
                              -fx-font-weight: bold;
                              -fx-font-family: 'Courier New';"/>
            </VBox>
        </StackPane>
    </HBox>

    <!-- ═══════════════════════════════════════════════════
         SEARCH BAR
    ═══════════════════════════════════════════════════ -->
    <HBox alignment="CENTER_LEFT" spacing="14"
          style="-fx-background-color: #071A10;
                 -fx-padding: 16 30 16 30;">

        <!-- Search icon + field -->
        <HBox spacing="10" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS"
              style="-fx-background-color: rgba(0,217,255,0.05);
                     -fx-border-color: rgba(0,217,255,0.20);
                     -fx-border-radius: 25; -fx-background-radius: 25;
                     -fx-padding: 0 14;">
            <Label text="🔍" style="-fx-font-size: 14px; -fx-text-fill: rgba(0,217,255,0.45);"/>
            <TextField fx:id="searchField"
                       promptText="Rechercher par titre ou description..."
                       HBox.hgrow="ALWAYS"
                       style="-fx-background-color: transparent;
                              -fx-text-fill: #E8FFF0;
                              -fx-prompt-text-fill: rgba(0,217,255,0.28);
                              -fx-border-color: transparent;
                              -fx-padding: 9 0;
                              -fx-font-size: 13px;
                              -fx-font-family: 'Courier New';"/>
        </HBox>

        <!-- Rechercher -->
        <Button text="🔍  Rechercher" onAction="#handleSearch"
                style="-fx-background-color: rgba(0,217,255,0.12);
                       -fx-text-fill: #00D9FF;
                       -fx-border-color: rgba(0,217,255,0.40); -fx-border-width: 1;
                       -fx-border-radius: 22; -fx-background-radius: 22;
                       -fx-padding: 9 22; -fx-font-weight: bold;
                       -fx-font-size: 13px; -fx-font-family: 'Courier New'; -fx-cursor: hand;"/>

        <!-- Actualiser -->
        <Button text="🔄  Actualiser" onAction="#handleReset"
                style="-fx-background-color: rgba(0,217,255,0.08);
                       -fx-text-fill: rgba(0,217,255,0.70);
                       -fx-border-color: rgba(0,217,255,0.25); -fx-border-width: 1;
                       -fx-border-radius: 22; -fx-background-radius: 22;
                       -fx-padding: 9 22; -fx-font-size: 13px;
                       -fx-font-family: 'Courier New'; -fx-cursor: hand;"/>

        <!-- Séparateur -->
        <Label text="|" style="-fx-text-fill: rgba(0,217,255,0.15); -fx-font-size: 18px;"/>

        <!-- Filtre Type -->
        <VBox spacing="3">
            <Label text="Type" style="-fx-text-fill: rgba(0,217,255,0.45); -fx-font-size: 10px; -fx-font-family: 'Courier New';"/>
            <ComboBox fx:id="filterType" prefWidth="130"
                      style="-fx-background-color: rgba(0,217,255,0.05);
                             -fx-border-color: rgba(0,217,255,0.20);
                             -fx-border-radius: 8; -fx-background-radius: 8;"/>
        </VBox>

        <!-- Filtre Statut -->
        <VBox spacing="3">
            <Label text="Statut" style="-fx-text-fill: rgba(0,217,255,0.45); -fx-font-size: 10px; -fx-font-family: 'Courier New';"/>
            <ComboBox fx:id="filterStatut" prefWidth="130"
                      style="-fx-background-color: rgba(0,217,255,0.05);
                             -fx-border-color: rgba(0,217,255,0.20);
                             -fx-border-radius: 8; -fx-background-radius: 8;"/>
        </VBox>

    </HBox>

    <!-- ═══════════════════════════════════════════════════
         TABLE HEADER LABEL
    ═══════════════════════════════════════════════════ -->
    <HBox alignment="CENTER_LEFT" spacing="10"
          style="-fx-padding: 6 30 10 30; -fx-background-color: #071A10;">
        <Label text="📋" style="-fx-font-size: 14px;"/>
        <Label text="Liste des ressources"
               style="-fx-text-fill: #00D9FF;
                      -fx-font-size: 14px;
                      -fx-font-weight: bold;
                      -fx-font-family: 'Courier New';"/>
    </HBox>

    <!-- ═══════════════════════════════════════════════════
         TABLE
    ═══════════════════════════════════════════════════ -->
    <TableView fx:id="tableRessources" VBox.vgrow="ALWAYS"
               style="-fx-background-color: #050C07;
                      -fx-control-inner-background: #071A10;
                      -fx-control-inner-background-alt: #071A10;
                      -fx-table-cell-border-color: rgba(0,217,255,0.07);
                      -fx-border-color: transparent;
                      -fx-padding: 0 30 0 30;">
        <VBox.margin>
            <Insets left="30" right="30" bottom="0"/>
        </VBox.margin>

        <columns>
            <TableColumn fx:id="titreCol"       text="Titre"       prefWidth="160"/>
            <TableColumn fx:id="descriptionCol" text="Description" prefWidth="200"/>
            <TableColumn fx:id="typeCol"        text="Type"        prefWidth="90"/>
            <TableColumn fx:id="formatCol"      text="Format"      prefWidth="70"/>
            <TableColumn fx:id="tailleCol"      text="Taille (Ko)" prefWidth="95"/>
            <TableColumn fx:id="statutCol"      text="Statut"      prefWidth="95"/>
            <TableColumn fx:id="dateCol"        text="Date"        prefWidth="105"/>
            <TableColumn fx:id="actionCol"      text="Actions"     prefWidth="160"/>
        </columns>

        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>

        <placeholder>
            <VBox alignment="CENTER" spacing="12" style="-fx-padding: 40;">
                <Label text="📂" style="-fx-font-size: 48px;"/>
                <Label text="Aucune ressource trouvée"
                       style="-fx-text-fill: rgba(0,217,255,0.35);
                              -fx-font-size: 15px;
                              -fx-font-family: 'Courier New';"/>
            </VBox>
        </placeholder>
    </TableView>

    <!-- ═══════════════════════════════════════════════════
         FOOTER BAR
    ═══════════════════════════════════════════════════ -->
    <HBox spacing="30" alignment="CENTER_LEFT"
          style="-fx-background-color: #071A10;
                 -fx-border-color: rgba(0,217,255,0.12); -fx-border-width: 1 0 0 0;
                 -fx-padding: 12 30;">
        <HBox spacing="8" alignment="CENTER_LEFT">
            <Label text="⇄" style="-fx-text-fill: #00D9FF; -fx-font-size: 13px;"/>
            <Label text="Modifier : ouvre le formulaire de modification"
                   style="-fx-text-fill: rgba(200,255,220,0.55); -fx-font-size: 11px; -fx-font-family: 'Courier New';"/>
        </HBox>
        <Label text="·" style="-fx-text-fill: rgba(0,217,255,0.20);"/>
        <HBox spacing="8" alignment="CENTER_LEFT">
            <Label text="⊟" style="-fx-text-fill: #FF4D6D; -fx-font-size: 13px;"/>
            <Label text="Supprimer : demande confirmation avant suppression"
                   style="-fx-text-fill: rgba(200,255,220,0.55); -fx-font-size: 11px; -fx-font-family: 'Courier New';"/>
        </HBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Label text="NEUROWELL · Gestion des Ressources"
               style="-fx-text-fill: rgba(0,217,255,0.25); -fx-font-size: 10px; -fx-font-family: 'Courier New';"/>
    </HBox>

</VBox>
