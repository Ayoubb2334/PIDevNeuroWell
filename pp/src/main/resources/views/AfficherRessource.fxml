<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="controllers.AfficherRessourceController"
      spacing="20" style="-fx-background-color: white; -fx-padding: 30;">

    <!-- HEADER -->
    <HBox alignment="CENTER_LEFT" spacing="20">
        <Label text="📚 Gestion des Ressources" style="-fx-text-fill: #2C3E50; -fx-font-weight: bold;">
            <font>
                <Font size="28"/>
            </font>
        </Label>
        <Region HBox.hgrow="ALWAYS"/>
    </HBox>

    <Separator style="-fx-background-color: #BDC3C7;"/>

    <!-- FILTRES ET RECHERCHE -->
    <VBox spacing="15" style="-fx-background-color: #ECF0F1; -fx-background-radius: 8; -fx-padding: 20;">
        <Label text="🔍 Recherche et Filtres" style="-fx-text-fill: #2C3E50; -fx-font-size: 16px; -fx-font-weight: bold;"/>

        <HBox spacing="15" alignment="CENTER_LEFT">
            <!-- Recherche -->
            <VBox spacing="5" HBox.hgrow="ALWAYS">
                <Label text="Rechercher" style="-fx-text-fill: #34495E; -fx-font-size: 12px;"/>
                <HBox spacing="10">
                    <TextField fx:id="searchField" promptText="Rechercher par titre ou description..." HBox.hgrow="ALWAYS"
                               style="-fx-background-color: white; -fx-border-color: #BDC3C7; -fx-border-radius: 5; -fx-background-radius: 5; -fx-padding: 8;"/>
                    <Button text="🔍" onAction="#handleSearch"
                            style="-fx-background-color: #3498DB; -fx-text-fill: white; -fx-background-radius: 5; -fx-padding: 8 20; -fx-font-weight: bold; -fx-cursor: hand;"/>
                </HBox>
            </VBox>

            <!-- Filtre Type -->
            <VBox spacing="5">
                <Label text="Type" style="-fx-text-fill: #34495E; -fx-font-size: 12px;"/>
                <ComboBox fx:id="filterType" prefWidth="150"
                          style="-fx-background-color: white; -fx-border-color: #BDC3C7;"/>
            </VBox>

            <!-- Filtre Statut -->
            <VBox spacing="5">
                <Label text="Statut" style="-fx-text-fill: #34495E; -fx-font-size: 12px;"/>
                <ComboBox fx:id="filterStatut" prefWidth="150"
                          style="-fx-background-color: white; -fx-border-color: #BDC3C7;"/>
            </VBox>

            <!-- Reset -->
            <VBox spacing="5">
                <Label text=" " style="-fx-font-size: 12px;"/>
                <Button text="🔄 Réinitialiser" onAction="#handleReset"
                        style="-fx-background-color: #E74C3C; -fx-text-fill: white; -fx-background-radius: 5; -fx-padding: 8 20; -fx-font-weight: bold; -fx-cursor: hand;"/>
            </VBox>
        </HBox>
    </VBox>

    <!-- TABLE -->
    <TableView fx:id="tableRessources" VBox.vgrow="ALWAYS"
               style="-fx-background-color: white; -fx-border-color: #BDC3C7; -fx-border-radius: 5;">
        <columns>
            <TableColumn fx:id="titreCol" text="Titre" prefWidth="150"/>
            <TableColumn fx:id="descriptionCol" text="Description" prefWidth="200"/>
            <TableColumn fx:id="typeCol" text="Type" prefWidth="80"/>
            <TableColumn fx:id="formatCol" text="Format" prefWidth="70"/>
            <TableColumn fx:id="tailleCol" text="Taille (Ko)" prefWidth="90"/>
            <TableColumn fx:id="statutCol" text="Statut" prefWidth="90"/>
            <TableColumn fx:id="dateCol" text="Date" prefWidth="100"/>
            <TableColumn fx:id="actionCol" text="Actions" prefWidth="150"/>
        </columns>
    </TableView>

    <!-- INSTRUCTIONS -->
    <VBox spacing="8" style="-fx-background-color: #E8F8F5; -fx-border-color: #1ABC9C; -fx-border-width: 2; -fx-border-radius: 5; -fx-background-radius: 5; -fx-padding: 15;">
        <Label text="💡 Instructions" style="-fx-text-fill: #16A085; -fx-font-weight: bold; -fx-font-size: 14px;"/>
        <Label text="• Cliquez sur ✏️ Modifier pour ouvrir le formulaire de modification" style="-fx-text-fill: #2C3E50; -fx-font-size: 12px;"/>
        <Label text="• Cliquez sur 🗑️ Supprimer pour supprimer une ressource" style="-fx-text-fill: #2C3E50; -fx-font-size: 12px;"/>
        <Label text="• Utilisez les filtres pour affiner votre recherche" style="-fx-text-fill: #2C3E50; -fx-font-size: 12px;"/>
    </VBox>

</VBox>
