<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.Rectangle?>

<ScrollPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="controllers.FrontController"
            fitToWidth="true"
            stylesheets="@/style/front.css">

    <VBox spacing="0" styleClass="main-container">

        <!-- Modern Navbar -->
        <HBox styleClass="navbar" alignment="CENTER_LEFT" spacing="30">
            <!-- Logo Section -->
            <HBox spacing="12" alignment="CENTER" styleClass="logo-container">
                <ImageView fitWidth="50" fitHeight="50" preserveRatio="true">
                    <image><Image url="@/images/logo.png"/></image>
                </ImageView>
                <Label text="neurowell" styleClass="logo-text"/>
            </HBox>

            <Region HBox.hgrow="ALWAYS"/>

            <!-- Navigation Buttons -->
            <HBox spacing="20" alignment="CENTER">
                <Button text="Accueil"      styleClass="nav-btn" fx:id="btnHome"/>
                <Button text="Services"     styleClass="nav-btn" fx:id="btnServices"/>
                <Button text="Méthode"      styleClass="nav-btn" fx:id="btnMethode"/>
                <Button text="Événements"   styleClass="nav-btn" fx:id="btnEvents"       onAction="#handleEvents"/>
                <!-- ══ NOUVEAU BOUTON ÉVALUATIONS ══ -->
                <Button text="Évaluations"  styleClass="nav-btn" fx:id="btnEvaluations"  onAction="#handleEvaluations"/>
                <!-- ══ NOUVEAU BOUTON RESSOURCES ══ -->
                <Button text="Ressources"   styleClass="nav-btn"                         onAction="#handleRessources"/>
                <Button text="Blog"         styleClass="nav-btn" fx:id="btnBlog"/>
            </HBox>

            <!-- Admin Button -->
            <Button text="⚡ Admin" styleClass="nav-cta-btn" fx:id="btnAdmin" onAction="#handleBackToAdmin"
                    style="-fx-background-color: rgba(0,217,255,0.15); -fx-border-color: #00D9FF; -fx-border-width: 1; -fx-border-radius: 20; -fx-background-radius: 20; -fx-text-fill: #00D9FF; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 8 20;"/>

            <!-- CTA Button -->
            <Button text="Contact" styleClass="nav-cta-btn" fx:id="btnContact" onAction="#handleContact"/>
        </HBox>

        <!-- Hero Section -->
        <StackPane styleClass="hero-section" prefHeight="600">
            <ImageView fx:id="heroImage" fitWidth="1400" fitHeight="600" preserveRatio="false">
                <image><Image url="@/images/1.jpg"/></image>
            </ImageView>
            <Rectangle width="1400" height="600" styleClass="hero-overlay"/>
            <VBox alignment="CENTER" spacing="25" styleClass="hero-content">
                <Label fx:id="heroTitle" styleClass="hero-title"
                       text="Transformez votre mental en superpouvoir"/>
                <Label fx:id="heroSubtitle" styleClass="hero-subtitle"
                       text="Une approche innovante qui fusionne neurosciences, psychologie positive&#10;et technologies pour débloquer votre plein potentiel mental"
                       wrapText="true"/>
                <HBox spacing="20" alignment="CENTER">
                    <Button text="Commencer maintenant" styleClass="hero-btn-primary" fx:id="btnGetStarted"/>
                    <Button text="Explorer" styleClass="hero-btn-secondary" fx:id="btnExplore"/>
                </HBox>
                <HBox spacing="30" alignment="CENTER" styleClass="floating-cards-container">
                    <VBox spacing="12" styleClass="floating-card" alignment="CENTER_LEFT">
                        <Label text="🧠" styleClass="card-emoji"/>
                        <Label text="Neuroplasticité" styleClass="card-title"/>
                        <Label text="Reprogrammez votre cerveau" styleClass="card-description"/>
                    </VBox>
                    <VBox spacing="12" styleClass="floating-card" alignment="CENTER_LEFT">
                        <Label text="⚡" styleClass="card-emoji"/>
                        <Label text="Performance" styleClass="card-title"/>
                        <Label text="Atteignez vos objectifs" styleClass="card-description"/>
                    </VBox>
                    <VBox spacing="12" styleClass="floating-card" alignment="CENTER_LEFT">
                        <Label text="✨" styleClass="card-emoji"/>
                        <Label text="Bien-être" styleClass="card-title"/>
                        <Label text="Équilibre et sérénité" styleClass="card-description"/>
                    </VBox>
                </HBox>
            </VBox>
        </StackPane>

        <!-- ══════ EVALUATION TEASER SECTION (nouveau) ══════ -->
        <HBox spacing="0" styleClass="services-section" alignment="CENTER">
            <VBox spacing="30" alignment="CENTER" HBox.hgrow="ALWAYS">
                <Label text="ÉVALUATIONS" styleClass="section-tag"/>
                <Label text="Comprenez votre état mental" styleClass="section-title" wrapText="true"/>
                <Label text="Nos outils d'évaluation psychologique vous permettent de mesurer&#10;votre niveau de stress, d'anxiété et de bien-être en quelques minutes."
                       styleClass="section-subtitle" wrapText="true"/>
                <HBox spacing="20" alignment="CENTER">
                    <VBox spacing="8" alignment="CENTER"
                          style="-fx-background-color: rgba(26,26,36,0.6); -fx-background-radius: 16;
                                 -fx-padding: 20 30; -fx-border-color: rgba(0,240,255,0.15);
                                 -fx-border-width: 1; -fx-border-radius: 16;">
                        <Label text="🧘" style="-fx-font-size: 28px;"/>
                        <Label text="Stress" style="-fx-text-fill: #00F0FF; -fx-font-size: 14px; -fx-font-weight: bold;"/>
                    </VBox>
                    <VBox spacing="8" alignment="CENTER"
                          style="-fx-background-color: rgba(26,26,36,0.6); -fx-background-radius: 16;
                                 -fx-padding: 20 30; -fx-border-color: rgba(0,240,255,0.15);
                                 -fx-border-width: 1; -fx-border-radius: 16;">
                        <Label text="😰" style="-fx-font-size: 28px;"/>
                        <Label text="Anxiété" style="-fx-text-fill: #00c853; -fx-font-size: 14px; -fx-font-weight: bold;"/>
                    </VBox>
                    <VBox spacing="8" alignment="CENTER"
                          style="-fx-background-color: rgba(26,26,36,0.6); -fx-background-radius: 16;
                                 -fx-padding: 20 30; -fx-border-color: rgba(0,240,255,0.15);
                                 -fx-border-width: 1; -fx-border-radius: 16;">
                        <Label text="⚡" style="-fx-font-size: 28px;"/>
                        <Label text="Burnout" style="-fx-text-fill: #FFD700; -fx-font-size: 14px; -fx-font-weight: bold;"/>
                    </VBox>
                    <VBox spacing="8" alignment="CENTER"
                          style="-fx-background-color: rgba(26,26,36,0.6); -fx-background-radius: 16;
                                 -fx-padding: 20 30; -fx-border-color: rgba(0,240,255,0.15);
                                 -fx-border-width: 1; -fx-border-radius: 16;">
                        <Label text="🌿" style="-fx-font-size: 28px;"/>
                        <Label text="Bien-être" style="-fx-text-fill: #84CC16; -fx-font-size: 14px; -fx-font-weight: bold;"/>
                    </VBox>
                </HBox>
                <Button text="Voir toutes les évaluations →" onAction="#handleEvaluations"
                        styleClass="hero-btn-primary"/>
            </VBox>
        </HBox>

        <!-- ══════ RESSOURCES TEASER SECTION ══════ -->
        <HBox spacing="0" styleClass="services-section" alignment="CENTER">
            <VBox spacing="30" alignment="CENTER" HBox.hgrow="ALWAYS">
                <Label text="RESSOURCES" styleClass="section-tag"/>
                <Label text="Votre bibliothèque de développement" styleClass="section-title" wrapText="true"/>
                <Label text="PDF, vidéos, articles et supports audio soigneusement sélectionnés&#10;pour accompagner votre progression à votre rythme."
                       styleClass="section-subtitle" wrapText="true"/>
                <HBox spacing="20" alignment="CENTER">
                    <VBox spacing="8" alignment="CENTER"
                          style="-fx-background-color: rgba(26,26,36,0.6); -fx-background-radius: 16;
                                 -fx-padding: 20 30; -fx-border-color: rgba(245,158,11,0.25);
                                 -fx-border-width: 1; -fx-border-radius: 16;">
                        <Label text="📕" style="-fx-font-size: 28px;"/>
                        <Label text="PDF" style="-fx-text-fill: #F59E0B; -fx-font-size: 14px; -fx-font-weight: bold;"/>
                    </VBox>
                    <VBox spacing="8" alignment="CENTER"
                          style="-fx-background-color: rgba(26,26,36,0.6); -fx-background-radius: 16;
                                 -fx-padding: 20 30; -fx-border-color: rgba(245,158,11,0.25);
                                 -fx-border-width: 1; -fx-border-radius: 16;">
                        <Label text="🎥" style="-fx-font-size: 28px;"/>
                        <Label text="Vidéos" style="-fx-text-fill: #F59E0B; -fx-font-size: 14px; -fx-font-weight: bold;"/>
                    </VBox>
                    <VBox spacing="8" alignment="CENTER"
                          style="-fx-background-color: rgba(26,26,36,0.6); -fx-background-radius: 16;
                                 -fx-padding: 20 30; -fx-border-color: rgba(245,158,11,0.25);
                                 -fx-border-width: 1; -fx-border-radius: 16;">
                        <Label text="📝" style="-fx-font-size: 28px;"/>
                        <Label text="Articles" style="-fx-text-fill: #F59E0B; -fx-font-size: 14px; -fx-font-weight: bold;"/>
                    </VBox>
                    <VBox spacing="8" alignment="CENTER"
                          style="-fx-background-color: rgba(26,26,36,0.6); -fx-background-radius: 16;
                                 -fx-padding: 20 30; -fx-border-color: rgba(245,158,11,0.25);
                                 -fx-border-width: 1; -fx-border-radius: 16;">
                        <Label text="🎵" style="-fx-font-size: 28px;"/>
                        <Label text="Audio" style="-fx-text-fill: #F59E0B; -fx-font-size: 14px; -fx-font-weight: bold;"/>
                    </VBox>
                </HBox>
                <Button text="Accéder à la bibliothèque →" onAction="#handleRessources"
                        styleClass="hero-btn-primary"/>
            </VBox>
        </HBox>

        <!-- About Section -->
        <HBox spacing="50" styleClass="about-section" alignment="CENTER">
            <ImageView fx:id="aboutImage" fitWidth="500" fitHeight="400" preserveRatio="true" styleClass="about-image">
                <image><Image url="@/images/2.jpeg"/></image>
            </ImageView>
            <VBox spacing="20" styleClass="about-content" prefWidth="550">
                <Label text="À PROPOS" styleClass="section-tag"/>
                <Label text="Une approche humaniste&#10;et bienveillante" styleClass="section-title" wrapText="true"/>
                <TabPane styleClass="about-tabs" prefWidth="550">
                    <tabs>
                        <Tab text="Mission" closable="false" styleClass="custom-tab">
                            <content>
                                <VBox spacing="15" styleClass="tab-content">
                                    <Label text="Notre pratique s'appuie sur des méthodes éprouvées en psychologie et développement personnel, dans le respect de votre rythme et de votre singularité."
                                           wrapText="true" styleClass="tab-text"/>
                                </VBox>
                            </content>
                        </Tab>
                        <Tab text="Vision" closable="false" styleClass="custom-tab">
                            <content>
                                <VBox spacing="15" styleClass="tab-content">
                                    <Label text="Nous croyons en votre capacité de croissance et de transformation. Notre rôle est de vous accompagner avec empathie et professionnalisme."
                                           wrapText="true" styleClass="tab-text"/>
                                </VBox>
                            </content>
                        </Tab>
                        <Tab text="Valeurs" closable="false" styleClass="custom-tab">
                            <content>
                                <VBox spacing="15" styleClass="tab-content">
                                    <Label text="Bienveillance, écoute active, apprentissage continu et empowerment personnel sont au cœur de notre approche."
                                           wrapText="true" styleClass="tab-text"/>
                                </VBox>
                            </content>
                        </Tab>
                    </tabs>
                </TabPane>
                <HBox spacing="25" alignment="CENTER_LEFT" styleClass="stats-container">
                    <VBox alignment="CENTER" styleClass="stat-item">
                        <Label text="10+" styleClass="stat-number"/>
                        <Label text="ANNÉES" styleClass="stat-label"/>
                    </VBox>
                    <VBox alignment="CENTER" styleClass="stat-item">
                        <Label text="500+" styleClass="stat-number"/>
                        <Label text="CLIENTS" styleClass="stat-label"/>
                    </VBox>
                </HBox>
            </VBox>
        </HBox>

        <!-- Global Stats Section -->
        <HBox spacing="50" styleClass="global-stats-section" alignment="CENTER">
            <VBox alignment="CENTER" styleClass="global-stat-card">
                <Label text="2K+" styleClass="global-stat-number"/>
                <Label text="CLIENTS TRANSFORMÉS" styleClass="global-stat-label"/>
            </VBox>
            <VBox alignment="CENTER" styleClass="global-stat-card">
                <Label text="94%" styleClass="global-stat-number"/>
                <Label text="TAUX DE RÉUSSITE" styleClass="global-stat-label"/>
            </VBox>
            <VBox alignment="CENTER" styleClass="global-stat-card">
                <Label text="15+" styleClass="global-stat-number"/>
                <Label text="ANNÉES D'EXPERTISE" styleClass="global-stat-label"/>
            </VBox>
            <VBox alignment="CENTER" styleClass="global-stat-card">
                <Label text="4.9/5" styleClass="global-stat-number"/>
                <Label text="SATISFACTION" styleClass="global-stat-label"/>
            </VBox>
        </HBox>

        <!-- Footer Section -->
        <HBox spacing="60" styleClass="footer-section" alignment="TOP_LEFT">
            <VBox spacing="15" styleClass="footer-column">
                <Label text="neurowell" styleClass="footer-brand"/>
                <Label text="Pionnier de la transformation mentale." styleClass="footer-description" wrapText="true"/>
                <VBox spacing="8">
                    <Label text="71 Rue Lafayette Decarlo" styleClass="footer-text"/>
                    <Label text="Cité Chaker, Tunisie" styleClass="footer-text"/>
                    <Label text="+216 27003897" styleClass="footer-text"/>
                    <Label text="contact@neurowell.tn" styleClass="footer-text"/>
                </VBox>
            </VBox>
            <VBox spacing="15" styleClass="footer-column">
                <Label text="Navigation" styleClass="footer-heading"/>
                <Label text="Accueil"    styleClass="footer-link" fx:id="footerHome"/>
                <Label text="Services"   styleClass="footer-link" fx:id="footerServices"/>
                <Label text="Méthode"    styleClass="footer-link" fx:id="footerMethode"/>
                <Label text="Blog"       styleClass="footer-link" fx:id="footerBlog"/>
            </VBox>
            <VBox spacing="15" styleClass="footer-column">
                <Label text="Services" styleClass="footer-heading"/>
                <Label text="Coaching Mental"    styleClass="footer-link"/>
                <Label text="Thérapie Innovante" styleClass="footer-link"/>
                <Label text="Peak Performance"   styleClass="footer-link"/>
                <Label text="Évaluations"        styleClass="footer-link"/>
            </VBox>
            <VBox spacing="15" styleClass="footer-column">
                <Label text="Newsletter" styleClass="footer-heading"/>
                <Label text="Restez informé de nos actualités" styleClass="footer-description" wrapText="true"/>
                <TextField fx:id="newsletterEmail" promptText="Votre email" styleClass="newsletter-input"/>
                <Button text="S'abonner" styleClass="newsletter-btn" fx:id="btnNewsletter" onAction="#handleNewsletter"/>
            </VBox>
        </HBox>

        <!-- Copyright Bar -->
        <HBox styleClass="copyright-bar" alignment="CENTER">
            <Label text="© 2026 neurowell. Tous droits réservés. Designed with innovation." styleClass="copyright-text"/>
        </HBox>

    </VBox>
</ScrollPane>
