<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.shape.*?>
<?import javafx.geometry.*?>

<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="controllers.QuestionnaireController"
           fx:id="rootPane"
           style="-fx-background-color: #050C07;"
           minWidth="900" minHeight="700"
           maxWidth="Infinity" maxHeight="Infinity">

    <!-- Animated Background Orbs -->
    <Pane mouseTransparent="true" style="-fx-background-color: transparent;"
          maxWidth="Infinity" maxHeight="Infinity">
        <Circle fx:id="orb1" radius="280"
                style="-fx-fill: radial-gradient(center 50% 50%, radius 100%, #00D9FF, transparent);"
                opacity="0.15"/>
        <Circle fx:id="orb2" radius="240"
                style="-fx-fill: radial-gradient(center 50% 50%, radius 100%, #00FF88, transparent);"
                opacity="0.15"/>
        <Circle fx:id="orb3" radius="200"
                style="-fx-fill: radial-gradient(center 50% 50%, radius 100%, #A78BFA, transparent);"
                opacity="0.12"/>
    </Pane>

    <!-- Full page VBox -->
    <VBox alignment="TOP_CENTER" maxWidth="Infinity" maxHeight="Infinity"
          style="-fx-background-color: transparent;">

        <!-- Top navbar with quit -->
        <HBox alignment="CENTER_LEFT" spacing="20"
              style="-fx-padding: 14 40 14 40; -fx-background-color: rgba(5,12,7,0.90);
                     -fx-border-color: rgba(0,217,255,0.12); -fx-border-width: 0 0 1 0;">
            <Label text="🧠  NeuroWell"
                   style="-fx-text-fill: #00D9FF; -fx-font-size: 16px; -fx-font-weight: bold;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="lblTopType" text=""
                   style="-fx-text-fill: rgba(200,255,220,0.50); -fx-font-size: 13px;"/>
            <Button text="✕  Quitter le test" onAction="#quitTest"
                    style="-fx-background-color: rgba(255,77,109,0.12);
                           -fx-border-color: rgba(255,77,109,0.45); -fx-border-width: 1;
                           -fx-border-radius: 20; -fx-background-radius: 20;
                           -fx-text-fill: #FF4D6D; -fx-font-size: 12px; -fx-font-weight: bold;
                           -fx-padding: 8 20; -fx-cursor: hand;"/>
        </HBox>

        <!-- Scrollable main content -->
        <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                    style="-fx-background-color: transparent; -fx-background: transparent;
                           -fx-border-color: transparent;" hbarPolicy="NEVER">
            <VBox alignment="TOP_CENTER" spacing="0" maxWidth="Infinity"
                  style="-fx-background-color: transparent; -fx-padding: 50 80 80 80;">

                <!-- Header -->
                <VBox spacing="10" alignment="CENTER" style="-fx-padding: 0 0 44 0;">
                    <Label text="⚡   NEUROWELL"
                           style="-fx-text-fill: #00D9FF; -fx-font-size: 13px;
                                  -fx-font-family: monospace; -fx-opacity: 0.7;"/>
                    <Label text="Évaluation Psychologique"
                           style="-fx-font-size: 34px; -fx-font-weight: bold; -fx-text-fill: #00D9FF;"/>
                    <Label text="Répondez honnêtement — le score se calcule automatiquement"
                           style="-fx-text-fill: rgba(200,255,220,0.55); -fx-font-size: 14px;"/>
                </VBox>

                <!-- PHASE 1 : Type selection -->
                <VBox fx:id="phaseIntro" spacing="28" maxWidth="Infinity">

                    <Label text="CHOISISSEZ VOTRE TYPE D'ÉVALUATION"
                           style="-fx-text-fill: rgba(200,255,220,0.55); -fx-font-size: 12px;
                                  -fx-font-weight: bold;"/>

                    <HBox spacing="14" alignment="CENTER" maxWidth="Infinity">
                        <VBox fx:id="btnStress" alignment="CENTER" spacing="12"
                              prefHeight="115" HBox.hgrow="ALWAYS" onMouseClicked="#selectStress"
                              style="-fx-cursor: hand; -fx-background-color: #0D1F12;
                                     -fx-border-color: rgba(0,217,255,0.30); -fx-border-width: 1.5;
                                     -fx-border-radius: 18; -fx-background-radius: 18;">
                            <Label text="🧘" style="-fx-font-size: 34px;"/>
                            <Label text="Stress" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: rgba(200,255,220,0.70);"/>
                        </VBox>
                        <VBox fx:id="btnAnxiete" alignment="CENTER" spacing="12"
                              prefHeight="115" HBox.hgrow="ALWAYS" onMouseClicked="#selectAnxiete"
                              style="-fx-cursor: hand; -fx-background-color: #0D1F12;
                                     -fx-border-color: rgba(0,255,136,0.30); -fx-border-width: 1.5;
                                     -fx-border-radius: 18; -fx-background-radius: 18;">
                            <Label text="😰" style="-fx-font-size: 34px;"/>
                            <Label text="Anxiété" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: rgba(200,255,220,0.70);"/>
                        </VBox>
                        <VBox fx:id="btnDepression" alignment="CENTER" spacing="12"
                              prefHeight="115" HBox.hgrow="ALWAYS" onMouseClicked="#selectDepression"
                              style="-fx-cursor: hand; -fx-background-color: #0D1F12;
                                     -fx-border-color: rgba(167,139,250,0.30); -fx-border-width: 1.5;
                                     -fx-border-radius: 18; -fx-background-radius: 18;">
                            <Label text="💙" style="-fx-font-size: 34px;"/>
                            <Label text="Dépression" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: rgba(200,255,220,0.70);"/>
                        </VBox>
                        <VBox fx:id="btnBienetre" alignment="CENTER" spacing="12"
                              prefHeight="115" HBox.hgrow="ALWAYS" onMouseClicked="#selectBienetre"
                              style="-fx-cursor: hand; -fx-background-color: #0D1F12;
                                     -fx-border-color: rgba(0,255,136,0.30); -fx-border-width: 1.5;
                                     -fx-border-radius: 18; -fx-background-radius: 18;">
                            <Label text="🌿" style="-fx-font-size: 34px;"/>
                            <Label text="Bien-être" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: rgba(200,255,220,0.70);"/>
                        </VBox>
                        <VBox fx:id="btnBurnout" alignment="CENTER" spacing="12"
                              prefHeight="115" HBox.hgrow="ALWAYS" onMouseClicked="#selectBurnout"
                              style="-fx-cursor: hand; -fx-background-color: #0D1F12;
                                     -fx-border-color: rgba(255,215,0,0.30); -fx-border-width: 1.5;
                                     -fx-border-radius: 18; -fx-background-radius: 18;">
                            <Label text="⚡" style="-fx-font-size: 34px;"/>
                            <Label text="Burnout" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: rgba(200,255,220,0.70);"/>
                        </VBox>
                    </HBox>

                    <VBox spacing="18" alignment="CENTER" style="-fx-padding: 16 0 0 0;">
                        <Label text="📝   10 questions · Résultat immédiat · Score automatique · Date sauvegardée automatiquement"
                               style="-fx-text-fill: rgba(200,255,220,0.45); -fx-font-size: 13px;"/>
                        <Button fx:id="btnStart" text="Commencer le questionnaire  →"
                                onAction="#startQuiz" maxWidth="360"
                                style="-fx-background-color: linear-gradient(to right,#00D9FF,#00FF88);
                                       -fx-text-fill: #050C07; -fx-font-weight: bold; -fx-font-size: 15px;
                                       -fx-padding: 16 60; -fx-background-radius: 30; -fx-cursor: hand;
                                       -fx-effect: dropshadow(gaussian,rgba(0,217,255,0.50),22,0.4,0,5);
                                       -fx-opacity: 0.35;"/>
                    </VBox>
                </VBox>

                <!-- PHASE 2 : Questions -->
                <VBox fx:id="phaseQuiz" spacing="26" visible="false" managed="false" maxWidth="Infinity">

                    <!-- Progress -->
                    <VBox spacing="12">
                        <HBox alignment="CENTER_LEFT">
                            <Label fx:id="lblCounter" text="Question 1 / 10"
                                   style="-fx-text-fill: rgba(200,255,220,0.55); -fx-font-size: 13px;"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="lblPct" text="0%"
                                   style="-fx-text-fill: #00D9FF; -fx-font-size: 13px; -fx-font-weight: bold;"/>
                        </HBox>
                        <StackPane alignment="CENTER_LEFT" prefHeight="8" maxWidth="Infinity">
                            <Rectangle fx:id="progressTrack" height="8" width="700"
                                       arcWidth="8" arcHeight="8" fill="rgba(0,217,255,0.12)"/>
                            <Rectangle fx:id="progressFill" height="8" width="0"
                                       arcWidth="8" arcHeight="8"
                                       fill="linear-gradient(to right, #00D9FF, #00FF88)"/>
                        </StackPane>
                        <HBox fx:id="dotsRow" spacing="8" alignment="CENTER"/>
                    </VBox>

                    <!-- Question card full width -->
                    <VBox fx:id="questionCard" spacing="24" maxWidth="Infinity"
                          style="-fx-background-color: #0D1F12;
                                 -fx-border-color: rgba(0,217,255,0.18); -fx-border-width: 1;
                                 -fx-border-radius: 24; -fx-background-radius: 24;
                                 -fx-padding: 38 44 34 44;">
                        <Label fx:id="lblQNumber" text="QUESTION 01"
                               style="-fx-text-fill: rgba(0,217,255,0.50); -fx-font-size: 12px;
                                      -fx-font-family: monospace;"/>
                        <Label fx:id="lblQText" text="" wrapText="true"
                               style="-fx-text-fill: #E8FFF0; -fx-font-size: 18px;
                                      -fx-font-weight: 600; -fx-line-spacing: 5;"/>
                        <HBox alignment="CENTER_LEFT">
                            <Label fx:id="lblScaleMin" text=""
                                   style="-fx-text-fill: rgba(200,255,220,0.45); -fx-font-size: 12px;"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="lblScaleMax" text=""
                                   style="-fx-text-fill: rgba(200,255,220,0.45); -fx-font-size: 12px;"/>
                        </HBox>
                        <!-- Scale buttons fill row -->
                        <HBox fx:id="scaleRow" spacing="14" alignment="CENTER" maxWidth="Infinity"/>
                    </VBox>

                    <!-- Nav -->
                    <HBox spacing="16" maxWidth="Infinity">
                        <Button fx:id="btnPrev" text="← Précédent" onAction="#prevQuestion"
                                prefWidth="180"
                                style="-fx-background-color: transparent;
                                       -fx-border-color: rgba(0,217,255,0.25); -fx-border-width: 1;
                                       -fx-border-radius: 16; -fx-background-radius: 16;
                                       -fx-text-fill: rgba(200,255,220,0.55); -fx-font-size: 13px;
                                       -fx-padding: 14 20; -fx-cursor: hand; -fx-opacity: 0.35;"/>
                        <Button fx:id="btnNext" text="Suivant →" onAction="#nextQuestion"
                                HBox.hgrow="ALWAYS" maxWidth="Infinity"
                                style="-fx-background-color: rgba(0,217,255,0.08);
                                       -fx-text-fill: rgba(200,255,220,0.35); -fx-font-size: 14px;
                                       -fx-padding: 14 24; -fx-border-radius: 16; -fx-background-radius: 16;"/>
                    </HBox>
                </VBox>

                <!-- PHASE 3 : Résultat -->
                <VBox fx:id="phaseResult" spacing="20" visible="false" managed="false" maxWidth="Infinity">

                    <VBox fx:id="scoreHeroBox" spacing="16" alignment="CENTER" maxWidth="Infinity"
                          style="-fx-background-color: #0D1F12;
                                 -fx-border-color: rgba(0,217,255,0.20); -fx-border-width: 1;
                                 -fx-border-radius: 24; -fx-background-radius: 24; -fx-padding: 44 44;">
                        <StackPane fx:id="scoreCirclePane"/>
                        <Label fx:id="lblScoreType" text=""
                               style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                        <Label fx:id="lblScoreDate" text=""
                               style="-fx-text-fill: rgba(200,255,220,0.45); -fx-font-size: 13px;"/>
                        <Label fx:id="lblNiveauBadge" text=""
                               style="-fx-font-size: 16px; -fx-font-weight: bold;
                                      -fx-padding: 10 30; -fx-border-radius: 30; -fx-background-radius: 30;"/>
                    </VBox>

                    <VBox spacing="10" maxWidth="Infinity"
                          style="-fx-background-color: #0D1F12; -fx-border-color: rgba(0,217,255,0.12);
                                 -fx-border-width: 1; -fx-border-radius: 20; -fx-background-radius: 20;
                                 -fx-padding: 26 32;">
                        <Label text="🔍  Interprétation"
                               style="-fx-text-fill: #00D9FF; -fx-font-size: 14px; -fx-font-weight: bold;"/>
                        <Label fx:id="lblInterp" text="" wrapText="true"
                               style="-fx-text-fill: #E8FFF0; -fx-font-size: 13px; -fx-line-spacing: 5;"/>
                    </VBox>

                    <VBox spacing="10" maxWidth="Infinity"
                          style="-fx-background-color: #0D1F12; -fx-border-color: rgba(0,217,255,0.12);
                                 -fx-border-width: 1; -fx-border-radius: 20; -fx-background-radius: 20;
                                 -fx-padding: 26 32;">
                        <Label text="💡  Recommandation"
                               style="-fx-text-fill: #00FF88; -fx-font-size: 14px; -fx-font-weight: bold;"/>
                        <Label fx:id="lblRecomm" text="" wrapText="true"
                               style="-fx-text-fill: #E8FFF0; -fx-font-size: 13px; -fx-line-spacing: 5;
                                      -fx-background-color: rgba(0,255,136,0.07);
                                      -fx-padding: 14 18; -fx-background-radius: 12;"/>
                    </VBox>

                    <VBox spacing="10" maxWidth="Infinity"
                          style="-fx-background-color: #0D1F12; -fx-border-color: rgba(0,217,255,0.12);
                                 -fx-border-width: 1; -fx-border-radius: 20; -fx-background-radius: 20;
                                 -fx-padding: 26 32;">
                        <Label text="📋  Détail de vos réponses"
                               style="-fx-text-fill: rgba(200,255,220,0.55); -fx-font-size: 13px; -fx-font-weight: bold;"/>
                        <VBox fx:id="answersContainer" spacing="6"/>
                    </VBox>

                    <!-- Result action buttons -->
                    <HBox spacing="14" maxWidth="Infinity">
                        <Button text="↩  Nouvelle évaluation" onAction="#restart"
                                HBox.hgrow="ALWAYS" maxWidth="Infinity"
                                style="-fx-background-color: transparent;
                                       -fx-border-color: rgba(0,217,255,0.35); -fx-border-width: 1.5;
                                       -fx-border-radius: 16; -fx-background-radius: 16;
                                       -fx-text-fill: #00D9FF; -fx-font-size: 13px; -fx-font-weight: bold;
                                       -fx-padding: 15; -fx-cursor: hand;"/>
                        <Button text="← Retour aux évaluations" onAction="#quitTest"
                                HBox.hgrow="ALWAYS" maxWidth="Infinity"
                                style="-fx-background-color: rgba(0,255,136,0.10);
                                       -fx-border-color: rgba(0,255,136,0.40); -fx-border-width: 1.5;
                                       -fx-border-radius: 16; -fx-background-radius: 16;
                                       -fx-text-fill: #00FF88; -fx-font-size: 13px; -fx-font-weight: bold;
                                       -fx-padding: 15; -fx-cursor: hand;"/>
                    </HBox>
                </VBox>

            </VBox>
        </ScrollPane>
    </VBox>
</StackPane>
