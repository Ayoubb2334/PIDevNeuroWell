<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<AnchorPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="controllers.AfficherEvaluationController"
            prefWidth="900" prefHeight="650"
            stylesheets="@/style/table.css"
            style="-fx-background-color: #f8f9fa;">

    <Label text="Liste des Évaluations" layoutX="30" layoutY="20" styleClass="logo-sidebar"/>

    <VBox layoutX="30" layoutY="70" prefWidth="840" spacing="15">
        <padding>
            <Insets top="10" left="10" right="10" bottom="10"/>
        </padding>

        <TableView fx:id="tableEvaluations" prefHeight="450" styleClass="custom-table">
            <columns>
                <TableColumn fx:id="typeTestCol" text="Type Test" prefWidth="200"/>
                <TableColumn fx:id="scoreCol"    text="Score"     prefWidth="120"/>
                <TableColumn fx:id="niveauCol"   text="Niveau"    prefWidth="150"/>
                <TableColumn fx:id="dateCol"     text="Date"      prefWidth="160"/>
                <TableColumn fx:id="actionCol"   text="Actions"   prefWidth="210"/>
            </columns>
        </TableView>

        <!-- INSTRUCTIONS -->
        <VBox spacing="8" style="-fx-background-color: #E8F8F5; -fx-border-color: #1ABC9C; -fx-border-width: 2; -fx-border-radius: 5; -fx-background-radius: 5; -fx-padding: 15;">
            <Label text="💡 Instructions" style="-fx-text-fill: #16A085; -fx-font-weight: bold; -fx-font-size: 14px;"/>
            <Label text="• Cliquez sur ✏️ Modifier pour ouvrir le formulaire de modification" style="-fx-text-fill: #2C3E50; -fx-font-size: 12px;"/>
            <Label text="• Cliquez sur 🗑️ Supprimer pour supprimer une évaluation" style="-fx-text-fill: #2C3E50; -fx-font-size: 12px;"/>
        </VBox>
    </VBox>

</AnchorPane>
