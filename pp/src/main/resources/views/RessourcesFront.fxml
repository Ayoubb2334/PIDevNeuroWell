<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>

<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="controllers.RessourcesFrontController"
           stylesheets="@../style/showEvents.css"
           styleClass="root-container">

    <!-- Animated Background Layer -->
    <Pane styleClass="background-layer">
        <Circle fx:id="orb1" radius="250" styleClass="orb, orb-1"/>
        <Circle fx:id="orb2" radius="200" styleClass="orb, orb-2"/>
        <Circle fx:id="orb3" radius="220" styleClass="orb, orb-3"/>
    </Pane>

    <!-- Main Content -->
    <VBox spacing="0" styleClass="main-container">

        <!-- Modern Navbar -->
        <HBox styleClass="navbar" alignment="CENTER_LEFT" spacing="30">
            <!-- Logo Section -->
            <HBox spacing="12" alignment="CENTER" styleClass="logo-container">
                <Label text="🧠" styleClass="logo-icon"/>
                <Label text="PSYCHÉ" styleClass="logo-text"/>
            </HBox>

            <!-- Spacer -->
            <Region HBox.hgrow="ALWAYS"/>

            <!-- Navigation Buttons -->
            <HBox spacing="25" alignment="CENTER">
                <Button text="Accueil"      styleClass="nav-btn" fx:id="btnBackToFront" onAction="#handleBackToFront"/>
                <Button text="Services"     styleClass="nav-btn"/>
                <Button text="Événements"   styleClass="nav-btn" onAction="#handleEvents"/>
                <Button text="Évaluations"  styleClass="nav-btn" onAction="#handleEvaluations"/>
                <Button text="Ressources"   styleClass="nav-btn, nav-btn-active"/>
                <Button text="Blog"         styleClass="nav-btn"/>
            </HBox>

            <!-- CTA Buttons -->
            <HBox spacing="15" alignment="CENTER">
                <Button text="Contact" styleClass="nav-cta-btn"/>
            </HBox>
        </HBox>

        <!-- Page Content with Scroll -->
        <ScrollPane fitToWidth="true" styleClass="content-scroll" VBox.vgrow="ALWAYS">
            <VBox spacing="40" styleClass="page-content">

                <!-- Hero Section -->
                <VBox spacing="20" styleClass="hero-section" alignment="CENTER">
                    <Label text="📚" styleClass="hero-icon"/>
                    <Label text="Bibliothèque de Ressources" styleClass="hero-title"/>
                    <Label text="Accédez à notre collection de documents, vidéos, et supports pour votre développement personnel"
                           styleClass="hero-subtitle" wrapText="true"/>
                </VBox>

                <!-- Search and Filters Section -->
                <VBox spacing="25" styleClass="filters-section">

                    <!-- Search Bar -->
                    <HBox spacing="15" alignment="CENTER" styleClass="search-container">
                        <TextField fx:id="searchField"
                                   promptText="🔍 Rechercher une ressource par titre ou description..."
                                   styleClass="search-input"
                                   HBox.hgrow="ALWAYS"/>
                        <Button text="Rechercher" styleClass="btn-search" fx:id="btnSearch" onAction="#handleSearch"/>
                        <Button text="Réinitialiser" styleClass="btn-reset" fx:id="btnReset" onAction="#resetFilters"/>
                    </HBox>

                    <!-- Filters Grid -->
                    <GridPane styleClass="filters-grid" hgap="30" vgap="20">

                        <!-- Type Filter Column -->
                        <VBox spacing="12" GridPane.columnIndex="0" GridPane.rowIndex="0" styleClass="filter-column">
                            <Label text="📁 Type de ressource" styleClass="filter-title"/>
                            <VBox spacing="8" styleClass="filter-options">
                                <CheckBox fx:id="filterPDF" text="📕 PDF" styleClass="filter-checkbox"/>
                                <CheckBox fx:id="filterVideo" text="🎥 Vidéo" styleClass="filter-checkbox"/>
                                <CheckBox fx:id="filterImage" text="🖼️ Image" styleClass="filter-checkbox"/>
                                <CheckBox fx:id="filterAudio" text="🎵 Audio" styleClass="filter-checkbox"/>
                                <CheckBox fx:id="filterArticle" text="📝 Article" styleClass="filter-checkbox"/>
                            </VBox>
                        </VBox>

                    </GridPane>
                </VBox>

                <!-- Resources Container -->
                <VBox spacing="20" styleClass="events-section">
                    <HBox alignment="CENTER_LEFT" spacing="15" styleClass="section-header">
                        <Label text="📚 Ressources disponibles" styleClass="section-title"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="resultsCount" text="" styleClass="results-count"/>
                    </HBox>

                    <!-- Resources List -->
                    <VBox fx:id="ressourcesContainer" spacing="20" styleClass="events-container">
                        <!-- Resource cards will be dynamically added here -->
                    </VBox>
                </VBox>

                <!-- ══════════════════════════════════════════════════
                     SECTION ÉVALUATIONS
                ══════════════════════════════════════════════════ -->
                <VBox spacing="25" styleClass="events-section">
                    <HBox alignment="CENTER_LEFT" spacing="15" styleClass="section-header">
                        <Label text="🧪 Évaluations Psychologiques" styleClass="section-title"/>
                    </HBox>

                    <HBox spacing="20" alignment="CENTER">

                        <!-- Carte Stress -->
                        <VBox spacing="15" alignment="CENTER"
                              style="-fx-background-color: rgba(37,37,54,0.9);
                                     -fx-background-radius: 16;
                                     -fx-padding: 28 24;
                                     -fx-border-color: rgba(124,58,237,0.25);
                                     -fx-border-width: 1;
                                     -fx-border-radius: 16;
                                     -fx-effect: dropshadow(gaussian, rgba(124,58,237,0.2), 10, 0, 0, 0);"
                              HBox.hgrow="ALWAYS">
                            <Label text="🧘" style="-fx-font-size: 36px;"/>
                            <Label text="Stress"
                                   style="-fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold;"/>
                            <Label text="Mesurez votre niveau de stress et obtenez des recommandations personnalisées."
                                   style="-fx-text-fill: #B8B8D1; -fx-font-size: 13px;"
                                   wrapText="true"/>
                            <Button text="Faire le test →" onAction="#handleEvaluations"
                                    style="-fx-background-color: rgba(124,58,237,0.3);
                                           -fx-text-fill: #A78BFA;
                                           -fx-border-color: rgba(124,58,237,0.5); -fx-border-width: 1;
                                           -fx-border-radius: 20; -fx-background-radius: 20;
                                           -fx-padding: 8 22; -fx-font-size: 13px;
                                           -fx-font-weight: bold; -fx-cursor: hand;"/>
                        </VBox>

                        <!-- Carte Anxiété -->
                        <VBox spacing="15" alignment="CENTER"
                              style="-fx-background-color: rgba(37,37,54,0.9);
                                     -fx-background-radius: 16;
                                     -fx-padding: 28 24;
                                     -fx-border-color: rgba(124,58,237,0.25);
                                     -fx-border-width: 1;
                                     -fx-border-radius: 16;
                                     -fx-effect: dropshadow(gaussian, rgba(124,58,237,0.2), 10, 0, 0, 0);"
                              HBox.hgrow="ALWAYS">
                            <Label text="😰" style="-fx-font-size: 36px;"/>
                            <Label text="Anxiété"
                                   style="-fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold;"/>
                            <Label text="Évaluez votre niveau d'anxiété et découvrez des stratégies adaptées."
                                   style="-fx-text-fill: #B8B8D1; -fx-font-size: 13px;"
                                   wrapText="true"/>
                            <Button text="Faire le test →" onAction="#handleEvaluations"
                                    style="-fx-background-color: rgba(124,58,237,0.3);
                                           -fx-text-fill: #A78BFA;
                                           -fx-border-color: rgba(124,58,237,0.5); -fx-border-width: 1;
                                           -fx-border-radius: 20; -fx-background-radius: 20;
                                           -fx-padding: 8 22; -fx-font-size: 13px;
                                           -fx-font-weight: bold; -fx-cursor: hand;"/>
                        </VBox>

                        <!-- Carte Burnout -->
                        <VBox spacing="15" alignment="CENTER"
                              style="-fx-background-color: rgba(37,37,54,0.9);
                                     -fx-background-radius: 16;
                                     -fx-padding: 28 24;
                                     -fx-border-color: rgba(124,58,237,0.25);
                                     -fx-border-width: 1;
                                     -fx-border-radius: 16;
                                     -fx-effect: dropshadow(gaussian, rgba(124,58,237,0.2), 10, 0, 0, 0);"
                              HBox.hgrow="ALWAYS">
                            <Label text="⚡" style="-fx-font-size: 36px;"/>
                            <Label text="Burnout"
                                   style="-fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold;"/>
                            <Label text="Détectez les signes d'épuisement professionnel avant qu'il ne soit trop tard."
                                   style="-fx-text-fill: #B8B8D1; -fx-font-size: 13px;"
                                   wrapText="true"/>
                            <Button text="Faire le test →" onAction="#handleEvaluations"
                                    style="-fx-background-color: rgba(124,58,237,0.3);
                                           -fx-text-fill: #A78BFA;
                                           -fx-border-color: rgba(124,58,237,0.5); -fx-border-width: 1;
                                           -fx-border-radius: 20; -fx-background-radius: 20;
                                           -fx-padding: 8 22; -fx-font-size: 13px;
                                           -fx-font-weight: bold; -fx-cursor: hand;"/>
                        </VBox>

                        <!-- Carte Bien-être -->
                        <VBox spacing="15" alignment="CENTER"
                              style="-fx-background-color: rgba(37,37,54,0.9);
                                     -fx-background-radius: 16;
                                     -fx-padding: 28 24;
                                     -fx-border-color: rgba(124,58,237,0.25);
                                     -fx-border-width: 1;
                                     -fx-border-radius: 16;
                                     -fx-effect: dropshadow(gaussian, rgba(124,58,237,0.2), 10, 0, 0, 0);"
                              HBox.hgrow="ALWAYS">
                            <Label text="🌿" style="-fx-font-size: 36px;"/>
                            <Label text="Bien-être"
                                   style="-fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold;"/>
                            <Label text="Mesurez votre bien-être global et identifiez les axes d'amélioration."
                                   style="-fx-text-fill: #B8B8D1; -fx-font-size: 13px;"
                                   wrapText="true"/>
                            <Button text="Faire le test →" onAction="#handleEvaluations"
                                    style="-fx-background-color: rgba(124,58,237,0.3);
                                           -fx-text-fill: #A78BFA;
                                           -fx-border-color: rgba(124,58,237,0.5); -fx-border-width: 1;
                                           -fx-border-radius: 20; -fx-background-radius: 20;
                                           -fx-padding: 8 22; -fx-font-size: 13px;
                                           -fx-font-weight: bold; -fx-cursor: hand;"/>
                        </VBox>

                    </HBox>

                    <!-- Bouton voir toutes les évaluations -->
                    <HBox alignment="CENTER">
                        <Button text="Voir toutes les évaluations →" onAction="#handleEvaluations"
                                styleClass="btn-search"
                                style="-fx-background-color: linear-gradient(to right, #7C3AED, #A78BFA);
                                       -fx-text-fill: white;
                                       -fx-background-radius: 25;
                                       -fx-padding: 12 32;
                                       -fx-font-size: 14px;
                                       -fx-font-weight: bold;
                                       -fx-cursor: hand;"/>
                    </HBox>
                </VBox>

                <!-- ══════════════════════════════════════════════════
                     SECTION ÉVÉNEMENTS
                ══════════════════════════════════════════════════ -->
                <VBox spacing="25" styleClass="events-section">
                    <HBox alignment="CENTER_LEFT" spacing="15" styleClass="section-header">
                        <Label text="📅 Événements &amp; Ateliers" styleClass="section-title"/>
                    </HBox>

                    <HBox spacing="20" alignment="CENTER">

                        <!-- Carte Atelier -->
                        <VBox spacing="15" alignment="CENTER_LEFT"
                              style="-fx-background-color: rgba(37,37,54,0.9);
                                     -fx-background-radius: 16;
                                     -fx-padding: 28 24;
                                     -fx-border-color: rgba(124,58,237,0.25);
                                     -fx-border-width: 1;
                                     -fx-border-radius: 16;
                                     -fx-effect: dropshadow(gaussian, rgba(124,58,237,0.2), 10, 0, 0, 0);"
                              HBox.hgrow="ALWAYS">
                            <Label text="🎯" style="-fx-font-size: 32px;"/>
                            <Label text="Ateliers pratiques"
                                   style="-fx-text-fill: white; -fx-font-size: 15px; -fx-font-weight: bold;"/>
                            <Label text="Des sessions interactives pour développer vos compétences mentales en groupe."
                                   style="-fx-text-fill: #B8B8D1; -fx-font-size: 13px;"
                                   wrapText="true"/>
                            <HBox spacing="8" alignment="CENTER_LEFT">
                                <Label text="📅" style="-fx-font-size: 12px;"/>
                                <Label text="Sessions régulières"
                                       style="-fx-text-fill: #A78BFA; -fx-font-size: 12px;"/>
                            </HBox>
                        </VBox>

                        <!-- Carte Séminaire -->
                        <VBox spacing="15" alignment="CENTER_LEFT"
                              style="-fx-background-color: rgba(37,37,54,0.9);
                                     -fx-background-radius: 16;
                                     -fx-padding: 28 24;
                                     -fx-border-color: rgba(124,58,237,0.25);
                                     -fx-border-width: 1;
                                     -fx-border-radius: 16;
                                     -fx-effect: dropshadow(gaussian, rgba(124,58,237,0.2), 10, 0, 0, 0);"
                              HBox.hgrow="ALWAYS">
                            <Label text="🧠" style="-fx-font-size: 32px;"/>
                            <Label text="Séminaires experts"
                                   style="-fx-text-fill: white; -fx-font-size: 15px; -fx-font-weight: bold;"/>
                            <Label text="Des conférences animées par des spécialistes en psychologie et bien-être."
                                   style="-fx-text-fill: #B8B8D1; -fx-font-size: 13px;"
                                   wrapText="true"/>
                            <HBox spacing="8" alignment="CENTER_LEFT">
                                <Label text="🎤" style="-fx-font-size: 12px;"/>
                                <Label text="Experts certifiés"
                                       style="-fx-text-fill: #A78BFA; -fx-font-size: 12px;"/>
                            </HBox>
                        </VBox>

                        <!-- Carte Groupe -->
                        <VBox spacing="15" alignment="CENTER_LEFT"
                              style="-fx-background-color: rgba(37,37,54,0.9);
                                     -fx-background-radius: 16;
                                     -fx-padding: 28 24;
                                     -fx-border-color: rgba(124,58,237,0.25);
                                     -fx-border-width: 1;
                                     -fx-border-radius: 16;
                                     -fx-effect: dropshadow(gaussian, rgba(124,58,237,0.2), 10, 0, 0, 0);"
                              HBox.hgrow="ALWAYS">
                            <Label text="👥" style="-fx-font-size: 32px;"/>
                            <Label text="Groupes de soutien"
                                   style="-fx-text-fill: white; -fx-font-size: 15px; -fx-font-weight: bold;"/>
                            <Label text="Rejoignez une communauté bienveillante pour progresser ensemble."
                                   style="-fx-text-fill: #B8B8D1; -fx-font-size: 13px;"
                                   wrapText="true"/>
                            <HBox spacing="8" alignment="CENTER_LEFT">
                                <Label text="🤝" style="-fx-font-size: 12px;"/>
                                <Label text="Communauté active"
                                       style="-fx-text-fill: #A78BFA; -fx-font-size: 12px;"/>
                            </HBox>
                        </VBox>

                    </HBox>

                    <!-- Bouton voir tous les événements -->
                    <HBox alignment="CENTER">
                        <Button text="Voir tous les événements →" onAction="#handleEvents"
                                style="-fx-background-color: linear-gradient(to right, #7C3AED, #A78BFA);
                                       -fx-text-fill: white;
                                       -fx-background-radius: 25;
                                       -fx-padding: 12 32;
                                       -fx-font-size: 14px;
                                       -fx-font-weight: bold;
                                       -fx-cursor: hand;"/>
                    </HBox>
                </VBox>

            </VBox>
        </ScrollPane>

        <!-- Footer Bar -->
        <HBox styleClass="footer-bar" alignment="CENTER" spacing="20">
            <Label text="© 2026 PSYCHÉ" styleClass="footer-text"/>
            <Label text="•" styleClass="footer-separator"/>
            <Label text="Développement Personnel" styleClass="footer-text"/>
            <Label text="•" styleClass="footer-separator"/>
            <Label text="Transformation Mentale" styleClass="footer-text"/>
        </HBox>

    </VBox>

</StackPane>
