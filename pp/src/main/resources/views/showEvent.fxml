<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>

<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="controllers.ShowEventController"
           stylesheets="@../style/showEvents.css"
           styleClass="root-container">

    <!-- Animated Background Layer -->
    <Pane styleClass="background-layer">
        <Circle fx:id="orb1" radius="250" styleClass="orb, orb-1"/>
        <Circle fx:id="orb2" radius="200" styleClass="orb, orb-2"/>
        <Circle fx:id="orb3" radius="220" styleClass="orb, orb-3"/>
    </Pane>

    <!-- Main Content -->
    <VBox spacing="0" styleClass="main-container">

        <!-- Modern Navbar -->
        <HBox styleClass="navbar" alignment="CENTER_LEFT" spacing="30">
            <!-- Logo Section -->
            <HBox spacing="12" alignment="CENTER" styleClass="logo-container">
                <Label text="🧠" styleClass="logo-icon"/>
                <Label text="NeuroWell" styleClass="logo-text"/>
            </HBox>

            <!-- Spacer -->
            <Region HBox.hgrow="ALWAYS"/>

            <!-- Navigation Buttons -->
            <HBox spacing="25" alignment="CENTER">
                <Button text="Accueil"     styleClass="nav-btn" fx:id="btnBackToFront" onAction="#handleBackToFront"/>
                <Button text="Services"    styleClass="nav-btn"/>
                <Button text="Événements"  styleClass="nav-btn, nav-btn-active"/>
                <Button text="Évaluations" styleClass="nav-btn" onAction="#handleGoToEvaluations"/>
                <Button text="Ressources"  styleClass="nav-btn" onAction="#handleGoToRessources"/>
                <Button text="Blog"        styleClass="nav-btn"/>
            </HBox>

            <!-- CTA Buttons -->
            <HBox spacing="15" alignment="CENTER">
                <Button text="Mes Participations" styleClass="nav-cta-btn-secondary" fx:id="btnParticipation" onAction="#handleParticipation"/>
                <Button text="Contact" styleClass="nav-cta-btn"/>
            </HBox>
        </HBox>

        <!-- Page Content with Scroll -->
        <ScrollPane fitToWidth="true" styleClass="content-scroll" VBox.vgrow="ALWAYS">
            <VBox spacing="40" styleClass="page-content">

                <!-- Hero Section -->
                <VBox spacing="20" styleClass="hero-section" alignment="CENTER">
                    <Label text="🎯" styleClass="hero-icon"/>
                    <Label text="Découvrez nos événements" styleClass="hero-title"/>
                    <Label text="Participez à nos conférences, formations et workshops pour développer votre potentiel"
                           styleClass="hero-subtitle" wrapText="true"/>
                </VBox>

                <!-- Search and Filters Section -->
                <VBox spacing="25" styleClass="filters-section">

                    <!-- Search Bar -->
                    <HBox spacing="15" alignment="CENTER" styleClass="search-container">
                        <TextField fx:id="searchField"
                                   promptText="🔍 Rechercher un événement par titre, lieu..."
                                   styleClass="search-input"
                                   HBox.hgrow="ALWAYS"/>
                        <Button text="Rechercher" styleClass="btn-search" fx:id="btnSearch" onAction="#handleSearch"/>
                        <Button text="Réinitialiser" styleClass="btn-reset" fx:id="btnReset" onAction="#resetFilters"/>
                    </HBox>

                    <!-- Filters Grid -->
                    <GridPane styleClass="filters-grid" hgap="30" vgap="20">

                        <!-- Date Filter Column -->
                        <VBox spacing="12" GridPane.columnIndex="0" GridPane.rowIndex="0" styleClass="filter-column">
                            <Label text="📅 Filtrer par date" styleClass="filter-title"/>
                            <DatePicker fx:id="dateFilter"
                                        promptText="Sélectionner une date"
                                        styleClass="date-picker-custom"/>
                        </VBox>

                        <!-- Type Filter Column -->
                        <VBox spacing="12" GridPane.columnIndex="1" GridPane.rowIndex="0" styleClass="filter-column">
                            <Label text="🎯 Type d'événement" styleClass="filter-title"/>
                            <VBox spacing="8" styleClass="filter-options">
                                <CheckBox fx:id="filterConference" text="Conférence" styleClass="filter-checkbox"/>
                                <CheckBox fx:id="filterFormation" text="Formation" styleClass="filter-checkbox"/>
                                <CheckBox fx:id="filterWorkshop" text="Workshop" styleClass="filter-checkbox"/>
                                <CheckBox fx:id="filterAutre" text="Autre" styleClass="filter-checkbox"/>
                            </VBox>
                        </VBox>

                        <!-- Price Filter Column -->
                        <VBox spacing="12" GridPane.columnIndex="2" GridPane.rowIndex="0" styleClass="filter-column">
                            <Label text="💰 Fourchette de prix" styleClass="filter-title"/>
                            <VBox spacing="8" styleClass="filter-options">
                                <CheckBox fx:id="filterGratuit" text="Gratuit" styleClass="filter-checkbox"/>
                                <CheckBox fx:id="filterPrixMoins40" text="Moins de 40 DT" styleClass="filter-checkbox"/>
                                <CheckBox fx:id="filterPrixPlus40" text="40 DT et plus" styleClass="filter-checkbox"/>
                            </VBox>
                        </VBox>

                    </GridPane>
                </VBox>

                <!-- Events Container -->
                <VBox spacing="20" styleClass="events-section">
                    <HBox alignment="CENTER_LEFT" spacing="15" styleClass="section-header">
                        <Label text="📋 Événements disponibles" styleClass="section-title"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="resultsCount" text="" styleClass="results-count"/>
                    </HBox>

                    <!-- Events List -->
                    <VBox fx:id="eventsContainer" spacing="20" styleClass="events-container">
                        <!-- Event cards will be dynamically added here -->
                    </VBox>
                </VBox>

                <!-- ── Section Ressources ── -->
                <VBox spacing="22"
                      style="-fx-background-color: rgba(19,36,24,0.6);
                             -fx-border-color: rgba(0,217,255,0.18);
                             -fx-border-width: 1; -fx-border-radius: 22; -fx-background-radius: 22;
                             -fx-padding: 35 35;">
                    <HBox alignment="CENTER_LEFT" spacing="12">
                        <Label text="📚" style="-fx-font-size: 22px;"/>
                        <Label text="Bibliothèque de Ressources"
                               style="-fx-text-fill: #00D9FF; -fx-font-size: 18px; -fx-font-weight: bold;"/>
                    </HBox>
                    <Label text="Préparez-vous à nos événements avec nos ressources : PDF, vidéos, articles et supports audio."
                           style="-fx-text-fill: rgba(160,224,192,0.70); -fx-font-size: 13px;"
                           wrapText="true"/>
                    <HBox spacing="18" alignment="CENTER">
                        <VBox spacing="10" alignment="CENTER" HBox.hgrow="ALWAYS"
                              style="-fx-background-color: rgba(0,217,255,0.06);
                                     -fx-border-color: rgba(0,217,255,0.20); -fx-border-width: 1;
                                     -fx-border-radius: 14; -fx-background-radius: 14; -fx-padding: 22 18;">
                            <Label text="📕" style="-fx-font-size: 28px;"/>
                            <Label text="PDF" style="-fx-text-fill: #00D9FF; -fx-font-size: 14px; -fx-font-weight: bold;"/>
                            <Label text="Guides &amp; fiches" style="-fx-text-fill: rgba(160,224,192,0.55); -fx-font-size: 11px;" wrapText="true"/>
                        </VBox>
                        <VBox spacing="10" alignment="CENTER" HBox.hgrow="ALWAYS"
                              style="-fx-background-color: rgba(0,255,136,0.06);
                                     -fx-border-color: rgba(0,255,136,0.20); -fx-border-width: 1;
                                     -fx-border-radius: 14; -fx-background-radius: 14; -fx-padding: 22 18;">
                            <Label text="🎥" style="-fx-font-size: 28px;"/>
                            <Label text="Vidéos" style="-fx-text-fill: #00FF88; -fx-font-size: 14px; -fx-font-weight: bold;"/>
                            <Label text="Séances guidées" style="-fx-text-fill: rgba(160,224,192,0.55); -fx-font-size: 11px;" wrapText="true"/>
                        </VBox>
                        <VBox spacing="10" alignment="CENTER" HBox.hgrow="ALWAYS"
                              style="-fx-background-color: rgba(167,139,250,0.06);
                                     -fx-border-color: rgba(167,139,250,0.20); -fx-border-width: 1;
                                     -fx-border-radius: 14; -fx-background-radius: 14; -fx-padding: 22 18;">
                            <Label text="📝" style="-fx-font-size: 28px;"/>
                            <Label text="Articles" style="-fx-text-fill: #A78BFA; -fx-font-size: 14px; -fx-font-weight: bold;"/>
                            <Label text="Lectures &amp; conseils" style="-fx-text-fill: rgba(160,224,192,0.55); -fx-font-size: 11px;" wrapText="true"/>
                        </VBox>
                        <VBox spacing="10" alignment="CENTER" HBox.hgrow="ALWAYS"
                              style="-fx-background-color: rgba(255,215,0,0.06);
                                     -fx-border-color: rgba(255,215,0,0.20); -fx-border-width: 1;
                                     -fx-border-radius: 14; -fx-background-radius: 14; -fx-padding: 22 18;">
                            <Label text="🎵" style="-fx-font-size: 28px;"/>
                            <Label text="Audio" style="-fx-text-fill: #FFD700; -fx-font-size: 14px; -fx-font-weight: bold;"/>
                            <Label text="Méditations sonores" style="-fx-text-fill: rgba(160,224,192,0.55); -fx-font-size: 11px;" wrapText="true"/>
                        </VBox>
                    </HBox>
                    <HBox alignment="CENTER">
                        <Button text="Accéder à la bibliothèque →" onAction="#handleGoToRessources"
                                style="-fx-background-color: rgba(0,217,255,0.15);
                                       -fx-text-fill: #00D9FF;
                                       -fx-border-color: rgba(0,217,255,0.45); -fx-border-width: 1;
                                       -fx-border-radius: 22; -fx-background-radius: 22;
                                       -fx-padding: 11 30; -fx-font-size: 14px; -fx-font-weight: bold;
                                       -fx-cursor: hand;
                                       -fx-effect: dropshadow(gaussian, rgba(0,217,255,0.30), 12, 0.2, 0, 0);"/>
                    </HBox>
                </VBox>

            </VBox>
        </ScrollPane>

        <!-- Footer Bar -->
        <HBox styleClass="footer-bar" alignment="CENTER" spacing="20">
            <Label text="© 2026 NeuroWell" styleClass="footer-text"/>
            <Label text="•" styleClass="footer-separator"/>
            <Label text="Développement Personnel" styleClass="footer-text"/>
            <Label text="•" styleClass="footer-separator"/>
            <Label text="Transformation Mentale" styleClass="footer-text"/>
        </HBox>

    </VBox>

</StackPane>
