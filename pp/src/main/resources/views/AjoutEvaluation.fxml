<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>

<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="controllers.AjoutEvaluationController"
           style="-fx-background-color: #050C07;">

    <ScrollPane fitToWidth="true"
                style="-fx-background-color: transparent; -fx-background: transparent;">

        <VBox spacing="30" alignment="TOP_CENTER"
              style="-fx-background-color: transparent; -fx-padding: 40 60 60 60;">

            <!-- ═══════ PAGE HEADER ═══════ -->
            <HBox alignment="CENTER_LEFT" spacing="16">
                <Label text="📊"
                       style="-fx-font-size: 32px;"/>
                <VBox spacing="3">
                    <Label text="Nouvelle Évaluation"
                           style="-fx-text-fill: #00D9FF; -fx-font-size: 24px; -fx-font-weight: bold;"/>
                    <Label text="Remplissez le formulaire pour enregistrer une évaluation"
                           style="-fx-text-fill: rgba(200,255,220,0.50); -fx-font-size: 12px;"/>
                </VBox>
            </HBox>

            <!-- ═══════ FORM CARD ═══════ -->
            <VBox spacing="24"
                  style="-fx-background-color: #0D1F12;
                         -fx-border-color: rgba(0,217,255,0.18);
                         -fx-border-width: 1;
                         -fx-border-radius: 20;
                         -fx-background-radius: 20;
                         -fx-padding: 36 40 36 40;
                         -fx-effect: dropshadow(gaussian, rgba(0,217,255,0.10), 30, 0.1, 0, 6);">

                <!-- Row 1 : Type de test + Score -->
                <HBox spacing="30">

                    <!-- Type de test -->
                    <VBox spacing="8" HBox.hgrow="ALWAYS">
                        <Label text="🎯  Type de test"
                               style="-fx-text-fill: rgba(0,217,255,0.80); -fx-font-size: 13px; -fx-font-weight: 600;"/>
                        <ComboBox fx:id="typeTestField"
                                  promptText="Sélectionnez un type"
                                  maxWidth="Infinity"
                                  style="-fx-background-color: #112016;
                                         -fx-text-fill: #E8FFF0;
                                         -fx-border-color: rgba(0,217,255,0.25);
                                         -fx-border-width: 1;
                                         -fx-border-radius: 10;
                                         -fx-background-radius: 10;
                                         -fx-padding: 10 14;
                                         -fx-font-size: 13px;"/>
                        <Label fx:id="typeTestError"
                               style="-fx-text-fill: #FF4D6D; -fx-font-size: 11px;" text=""/>
                    </VBox>

                    <!-- Score -->
                    <VBox spacing="8" HBox.hgrow="ALWAYS">
                        <Label text="🔢  Score (0–100)"
                               style="-fx-text-fill: rgba(0,217,255,0.80); -fx-font-size: 13px; -fx-font-weight: 600;"/>
                        <TextField fx:id="scoreField"
                                   promptText="Entrez le score"
                                   style="-fx-background-color: #112016;
                                          -fx-text-fill: #E8FFF0;
                                          -fx-prompt-text-fill: rgba(200,255,220,0.30);
                                          -fx-border-color: rgba(0,217,255,0.25);
                                          -fx-border-width: 1;
                                          -fx-border-radius: 10;
                                          -fx-background-radius: 10;
                                          -fx-padding: 10 14;
                                          -fx-font-size: 13px;"/>
                        <Label fx:id="scoreError"
                               style="-fx-text-fill: #FF4D6D; -fx-font-size: 11px;" text=""/>
                    </VBox>
                </HBox>

                <!-- Row 2 : Niveau + Date -->
                <HBox spacing="30">

                    <!-- Niveau (lecture seule — auto-calculé) -->
                    <VBox spacing="8" HBox.hgrow="ALWAYS">
                        <Label text="📈  Niveau (automatique)"
                               style="-fx-text-fill: rgba(0,217,255,0.80); -fx-font-size: 13px; -fx-font-weight: 600;"/>
                        <StackPane maxWidth="Infinity" prefHeight="40"
                                   style="-fx-background-color: #0A1A0E;
                                          -fx-border-color: rgba(0,217,255,0.15);
                                          -fx-border-width: 1;
                                          -fx-border-radius: 10;
                                          -fx-background-radius: 10;
                                          -fx-padding: 0;">
                            <Label fx:id="niveauDisplay" text="— Saisissez un score —"
                                   style="-fx-text-fill: rgba(200,255,220,0.35);
                                          -fx-font-size: 13px; -fx-font-weight: 600;
                                          -fx-padding: 10 14;"/>
                        </StackPane>
                        <Label fx:id="niveauError"
                               style="-fx-text-fill: #FF4D6D; -fx-font-size: 11px;" text=""/>
                    </VBox>

                    <!-- Date -->
                    <VBox spacing="8" HBox.hgrow="ALWAYS">
                        <Label text="📅  Date de l'évaluation"
                               style="-fx-text-fill: rgba(0,217,255,0.80); -fx-font-size: 13px; -fx-font-weight: 600;"/>
                        <DatePicker fx:id="dateField"
                                    promptText="Sélectionnez une date"
                                    maxWidth="Infinity"
                                    style="-fx-background-color: #112016;
                                           -fx-border-color: rgba(0,217,255,0.25);
                                           -fx-border-width: 1;
                                           -fx-border-radius: 10;
                                           -fx-background-radius: 10;
                                           -fx-padding: 4 14;
                                           -fx-font-size: 13px;"/>
                        <Label fx:id="dateError"
                               style="-fx-text-fill: #FF4D6D; -fx-font-size: 11px;" text=""/>
                    </VBox>
                </HBox>

                <!-- Info hint -->
                <HBox spacing="10" alignment="CENTER_LEFT"
                      style="-fx-background-color: rgba(0,217,255,0.06);
                             -fx-border-color: rgba(0,217,255,0.20);
                             -fx-border-width: 1;
                             -fx-border-radius: 10;
                             -fx-background-radius: 10;
                             -fx-padding: 12 16;">
                    <Label text="💡"  style="-fx-font-size: 16px;"/>
                    <Label text="Le niveau est calculé automatiquement selon le score : 0–20 = Faible · 21–50 = Moyen · 51–100 = Élevé"
                           style="-fx-text-fill: rgba(0,217,255,0.65); -fx-font-size: 12px;"
                           wrapText="true"/>
                </HBox>

                <!-- Buttons -->
                <HBox spacing="16" alignment="CENTER_RIGHT">
                    <Button fx:id="cancelBtn" text="✖  Annuler"
                            style="-fx-background-color: transparent;
                                   -fx-border-color: rgba(255,77,109,0.50);
                                   -fx-border-width: 1;
                                   -fx-border-radius: 12;
                                   -fx-background-radius: 12;
                                   -fx-text-fill: #FF4D6D;
                                   -fx-font-size: 13px; -fx-font-weight: 600;
                                   -fx-padding: 11 28;
                                   -fx-cursor: hand;"/>
                    <Button fx:id="submitBtn" text="✔  Enregistrer l'évaluation"
                            style="-fx-background-color: linear-gradient(to right, #00D9FF, #00FF88);
                                   -fx-text-fill: #050C07;
                                   -fx-font-size: 13px; -fx-font-weight: bold;
                                   -fx-padding: 11 32;
                                   -fx-background-radius: 12;
                                   -fx-cursor: hand;
                                   -fx-effect: dropshadow(gaussian, rgba(0,217,255,0.40), 16, 0.3, 0, 0);"/>
                </HBox>

            </VBox>
        </VBox>
    </ScrollPane>
</StackPane>
