<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="controllers.ModifierRessourceController"
      spacing="0"
      style="-fx-background-color: #050C07;">

    <!-- ═══ HEADER ═══ -->
    <HBox alignment="CENTER_LEFT" spacing="16"
          style="-fx-background-color: #071A10;
                 -fx-border-color: rgba(0,217,255,0.18);
                 -fx-border-width: 0 0 1 0;
                 -fx-padding: 20 30;">
        <StackPane style="-fx-background-color: rgba(0,217,255,0.12);
                          -fx-border-color: rgba(0,217,255,0.35);
                          -fx-border-width: 1;
                          -fx-background-radius: 8;
                          -fx-border-radius: 8;"
                   prefWidth="42" prefHeight="42">
            <Label text="⇄" style="-fx-font-size: 20px; -fx-text-fill: #00D9FF;"/>
        </StackPane>
        <VBox spacing="3">
            <Label text="Modifier une Ressource"
                   style="-fx-text-fill: #00D9FF;
                          -fx-font-size: 22px;
                          -fx-font-weight: bold;
                          -fx-font-family: 'Courier New';"/>
            <Label text="Modifiez les champs souhaités puis enregistrez"
                   style="-fx-text-fill: rgba(0,217,255,0.45);
                          -fx-font-size: 12px;
                          -fx-font-family: 'Courier New';"/>
        </VBox>
    </HBox>

    <!-- ═══ FORM ═══ -->
    <ScrollPane fitToWidth="true"
                style="-fx-background: transparent; -fx-background-color: transparent; -fx-border-color: transparent;"
                VBox.vgrow="ALWAYS">
        <VBox spacing="22" style="-fx-background-color: #071A10; -fx-padding: 28 30;">

            <!-- TITRE -->
            <VBox spacing="7">
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Label text="📝" style="-fx-font-size: 14px;"/>
                    <Label text="Titre *"
                           style="-fx-text-fill: #00D9FF; -fx-font-size: 13px; -fx-font-weight: bold; -fx-font-family: 'Courier New';"/>
                </HBox>
                <TextField fx:id="titreField" promptText="Ex: Introduction à la psychologie"
                           style="-fx-background-color: rgba(0,217,255,0.04);
                                  -fx-text-fill: #E8FFF0;
                                  -fx-prompt-text-fill: rgba(0,217,255,0.25);
                                  -fx-border-color: rgba(0,217,255,0.25);
                                  -fx-border-radius: 8; -fx-background-radius: 8;
                                  -fx-padding: 11 14; -fx-font-size: 13px;
                                  -fx-font-family: 'Courier New';"/>
                <Label fx:id="titreError" style="-fx-text-fill: #FF4D6D; -fx-font-size: 11px;"/>
            </VBox>

            <!-- DESCRIPTION -->
            <VBox spacing="7">
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Label text="📄" style="-fx-font-size: 14px;"/>
                    <Label text="Description"
                           style="-fx-text-fill: #00D9FF; -fx-font-size: 13px; -fx-font-weight: bold; -fx-font-family: 'Courier New';"/>
                </HBox>
                <TextArea fx:id="descriptionField" promptText="Description de la ressource..."
                          prefRowCount="3" wrapText="true"
                          style="-fx-background-color: rgba(0,217,255,0.04);
                                 -fx-text-fill: #E8FFF0;
                                 -fx-prompt-text-fill: rgba(0,217,255,0.25);
                                 -fx-border-color: rgba(0,217,255,0.25);
                                 -fx-border-radius: 8; -fx-background-radius: 8;
                                 -fx-padding: 11 14; -fx-font-size: 13px;
                                 -fx-font-family: 'Courier New';"/>
                <Label fx:id="descriptionError" style="-fx-text-fill: #FF4D6D; -fx-font-size: 11px;"/>
            </VBox>

            <!-- TYPE -->
            <VBox spacing="7">
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Label text="🏷️" style="-fx-font-size: 14px;"/>
                    <Label text="Type *"
                           style="-fx-text-fill: #00D9FF; -fx-font-size: 13px; -fx-font-weight: bold; -fx-font-family: 'Courier New';"/>
                </HBox>
                <ComboBox fx:id="typeField" promptText="Sélectionnez un type" maxWidth="Infinity"
                          style="-fx-background-color: rgba(0,217,255,0.04);
                                 -fx-border-color: rgba(0,217,255,0.25);
                                 -fx-border-radius: 8; -fx-background-radius: 8;"/>
                <Label fx:id="typeError" style="-fx-text-fill: #FF4D6D; -fx-font-size: 11px;"/>
            </VBox>

            <!-- FICHIER -->
            <VBox spacing="7">
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Label text="📂" style="-fx-font-size: 14px;"/>
                    <Label text="Fichier *"
                           style="-fx-text-fill: #00D9FF; -fx-font-size: 13px; -fx-font-weight: bold; -fx-font-family: 'Courier New';"/>
                </HBox>
                <HBox spacing="10">
                    <TextField fx:id="cheminField" promptText="Chemin du fichier..."
                               editable="false" HBox.hgrow="ALWAYS"
                               style="-fx-background-color: rgba(0,217,255,0.04);
                                      -fx-text-fill: rgba(200,255,220,0.70);
                                      -fx-prompt-text-fill: rgba(0,217,255,0.25);
                                      -fx-border-color: rgba(0,217,255,0.20);
                                      -fx-border-radius: 8; -fx-background-radius: 8;
                                      -fx-padding: 11 14; -fx-font-size: 13px;
                                      -fx-font-family: 'Courier New';"/>
                    <Button fx:id="btnChooseFile" text="Parcourir"
                            style="-fx-background-color: rgba(0,217,255,0.15);
                                   -fx-text-fill: #00D9FF;
                                   -fx-border-color: #00D9FF; -fx-border-width: 1;
                                   -fx-border-radius: 8; -fx-background-radius: 8;
                                   -fx-padding: 11 20; -fx-font-weight: bold;
                                   -fx-font-size: 13px; -fx-font-family: 'Courier New'; -fx-cursor: hand;"/>
                </HBox>
                <Label fx:id="cheminError" style="-fx-text-fill: #FF4D6D; -fx-font-size: 11px;"/>
            </VBox>

            <!-- TAILLE + FORMAT -->
            <HBox spacing="20">
                <VBox spacing="7" HBox.hgrow="ALWAYS">
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <Label text="💾" style="-fx-font-size: 14px;"/>
                        <Label text="Taille (Ko)"
                               style="-fx-text-fill: #00D9FF; -fx-font-size: 13px; -fx-font-weight: bold; -fx-font-family: 'Courier New';"/>
                    </HBox>
                    <TextField fx:id="tailleField" editable="false"
                               style="-fx-background-color: rgba(0,217,255,0.03);
                                      -fx-text-fill: rgba(200,255,220,0.60);
                                      -fx-border-color: rgba(0,217,255,0.15);
                                      -fx-border-radius: 8; -fx-background-radius: 8;
                                      -fx-padding: 11 14; -fx-font-size: 13px;
                                      -fx-font-family: 'Courier New';"/>
                    <Label fx:id="tailleError" style="-fx-text-fill: #FF4D6D; -fx-font-size: 11px;"/>
                </VBox>
                <VBox spacing="7" HBox.hgrow="ALWAYS">
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <Label text="🗂️" style="-fx-font-size: 14px;"/>
                        <Label text="Format"
                               style="-fx-text-fill: #00D9FF; -fx-font-size: 13px; -fx-font-weight: bold; -fx-font-family: 'Courier New';"/>
                    </HBox>
                    <TextField fx:id="formatField" editable="false"
                               style="-fx-background-color: rgba(0,217,255,0.03);
                                      -fx-text-fill: rgba(200,255,220,0.60);
                                      -fx-border-color: rgba(0,217,255,0.15);
                                      -fx-border-radius: 8; -fx-background-radius: 8;
                                      -fx-padding: 11 14; -fx-font-size: 13px;
                                      -fx-font-family: 'Courier New';"/>
                    <Label fx:id="formatError" style="-fx-text-fill: #FF4D6D; -fx-font-size: 11px;"/>
                </VBox>
            </HBox>

            <!-- DATE + STATUT -->
            <HBox spacing="20">
                <VBox spacing="7" HBox.hgrow="ALWAYS">
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <Label text="📅" style="-fx-font-size: 14px;"/>
                        <Label text="Date de publication *"
                               style="-fx-text-fill: #00D9FF; -fx-font-size: 13px; -fx-font-weight: bold; -fx-font-family: 'Courier New';"/>
                    </HBox>
                    <DatePicker fx:id="dateField" maxWidth="Infinity"
                                style="-fx-background-color: rgba(0,217,255,0.04);
                                       -fx-border-color: rgba(0,217,255,0.25);
                                       -fx-border-radius: 8; -fx-background-radius: 8;"/>
                    <Label fx:id="dateError" style="-fx-text-fill: #FF4D6D; -fx-font-size: 11px;"/>
                </VBox>
                <VBox spacing="7" HBox.hgrow="ALWAYS">
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <Label text="🔖" style="-fx-font-size: 14px;"/>
                        <Label text="Statut *"
                               style="-fx-text-fill: #00D9FF; -fx-font-size: 13px; -fx-font-weight: bold; -fx-font-family: 'Courier New';"/>
                    </HBox>
                    <ComboBox fx:id="statutField" promptText="brouillon" maxWidth="Infinity"
                              style="-fx-background-color: rgba(0,217,255,0.04);
                                     -fx-border-color: rgba(0,217,255,0.25);
                                     -fx-border-radius: 8; -fx-background-radius: 8;"/>
                    <Label fx:id="statutError" style="-fx-text-fill: #FF4D6D; -fx-font-size: 11px;"/>
                </VBox>
            </HBox>

        </VBox>
    </ScrollPane>

    <!-- ═══ BUTTONS ═══ -->
    <HBox spacing="16" alignment="CENTER_RIGHT"
          style="-fx-background-color: #071A10;
                 -fx-border-color: rgba(0,217,255,0.12); -fx-border-width: 1 0 0 0;
                 -fx-padding: 18 30;">
        <Button fx:id="cancelBtn" text="✖  Annuler"
                style="-fx-background-color: rgba(255,77,109,0.15);
                       -fx-text-fill: #FF4D6D;
                       -fx-border-color: #FF4D6D; -fx-border-width: 1;
                       -fx-border-radius: 20; -fx-background-radius: 20;
                       -fx-padding: 10 28; -fx-font-size: 13px; -fx-font-weight: bold;
                       -fx-font-family: 'Courier New'; -fx-cursor: hand;"/>
        <Button fx:id="submitBtn" text="✔  Enregistrer les modifications"
                style="-fx-background-color: #00FF88;
                       -fx-text-fill: #050C07;
                       -fx-border-color: #00FF88; -fx-border-width: 1;
                       -fx-border-radius: 20; -fx-background-radius: 20;
                       -fx-padding: 10 28; -fx-font-size: 13px; -fx-font-weight: bold;
                       -fx-font-family: 'Courier New'; -fx-cursor: hand;
                       -fx-effect: dropshadow(gaussian, rgba(0,255,136,0.45), 12, 0.2, 0, 0);"/>
    </HBox>

</VBox>
