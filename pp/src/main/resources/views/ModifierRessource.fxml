<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="controllers.ModifierRessourceController"
      spacing="0"
      style="-fx-background-color: #0F0F1A;"
      prefWidth="540">

    <!-- HEADER -->
    <HBox alignment="CENTER_LEFT" spacing="14"
          style="-fx-background-color: rgba(124,58,237,0.15);
                 -fx-border-color: rgba(124,58,237,0.3);
                 -fx-border-width: 0 0 1 0;
                 -fx-padding: 18 28;">
        <Label text="✏️" style="-fx-font-size: 26px;"/>
        <VBox spacing="2">
            <Label text="Modifier une Ressource"
                   style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;"/>
            <Label text="Modifiez les champs souhaités puis enregistrez"
                   style="-fx-text-fill: #A78BFA; -fx-font-size: 11px;"/>
        </VBox>
    </HBox>

    <!-- FORM -->
    <ScrollPane fitToWidth="true"
                style="-fx-background: transparent; -fx-background-color: transparent;"
                prefHeight="420"
                VBox.vgrow="ALWAYS">

        <VBox spacing="18" style="-fx-padding: 24 28;">

            <!-- TITRE -->
            <VBox spacing="6">
                <Label text="Titre *"
                       style="-fx-text-fill: #A78BFA; -fx-font-size: 12px; -fx-font-weight: bold;"/>
                <TextField fx:id="titreField" promptText="Ex: Introduction à la psychologie"
                           style="-fx-background-color: rgba(15,15,26,0.9);
                                  -fx-text-fill: white;
                                  -fx-prompt-text-fill: #6B6B8A;
                                  -fx-border-color: rgba(124,58,237,0.4);
                                  -fx-border-radius: 8;
                                  -fx-background-radius: 8;
                                  -fx-padding: 10 14;
                                  -fx-font-size: 13px;"/>
                <Label fx:id="titreError"
                       style="-fx-text-fill: #F87171; -fx-font-size: 11px;"/>
            </VBox>

            <!-- DESCRIPTION -->
            <VBox spacing="6">
                <Label text="Description"
                       style="-fx-text-fill: #A78BFA; -fx-font-size: 12px; -fx-font-weight: bold;"/>
                <TextArea fx:id="descriptionField" promptText="Description de la ressource..."
                          prefRowCount="3" wrapText="true"
                          style="-fx-background-color: rgba(15,15,26,0.9);
                                 -fx-text-fill: white;
                                 -fx-prompt-text-fill: #6B6B8A;
                                 -fx-border-color: rgba(124,58,237,0.4);
                                 -fx-border-radius: 8;
                                 -fx-background-radius: 8;
                                 -fx-padding: 10 14;
                                 -fx-font-size: 13px;"/>
                <Label fx:id="descriptionError"
                       style="-fx-text-fill: #F87171; -fx-font-size: 11px;"/>
            </VBox>

            <!-- TYPE -->
            <VBox spacing="6">
                <Label text="Type *"
                       style="-fx-text-fill: #A78BFA; -fx-font-size: 12px; -fx-font-weight: bold;"/>
                <ComboBox fx:id="typeField" promptText="Sélectionnez un type" maxWidth="Infinity"
                          style="-fx-background-color: rgba(15,15,26,0.9);
                                 -fx-border-color: rgba(124,58,237,0.4);
                                 -fx-border-radius: 8;
                                 -fx-background-radius: 8;"/>
                <Label fx:id="typeError"
                       style="-fx-text-fill: #F87171; -fx-font-size: 11px;"/>
            </VBox>

            <!-- FICHIER -->
            <VBox spacing="6">
                <Label text="Fichier *"
                       style="-fx-text-fill: #A78BFA; -fx-font-size: 12px; -fx-font-weight: bold;"/>
                <HBox spacing="10">
                    <TextField fx:id="cheminField" promptText="Chemin du fichier..."
                               editable="false" HBox.hgrow="ALWAYS"
                               style="-fx-background-color: rgba(15,15,26,0.6);
                                      -fx-text-fill: #B8B8D1;
                                      -fx-prompt-text-fill: #6B6B8A;
                                      -fx-border-color: rgba(124,58,237,0.3);
                                      -fx-border-radius: 8;
                                      -fx-background-radius: 8;
                                      -fx-padding: 10 14;
                                      -fx-font-size: 13px;"/>
                    <Button fx:id="btnChooseFile" text="📂  Parcourir"
                            style="-fx-background-color: #7C3AED;
                                   -fx-text-fill: white;
                                   -fx-background-radius: 8;
                                   -fx-padding: 10 18;
                                   -fx-font-weight: bold;
                                   -fx-font-size: 13px;
                                   -fx-cursor: hand;"/>
                </HBox>
                <Label fx:id="cheminError"
                       style="-fx-text-fill: #F87171; -fx-font-size: 11px;"/>
            </VBox>

            <!-- TAILLE + FORMAT -->
            <HBox spacing="15">
                <VBox spacing="6" HBox.hgrow="ALWAYS">
                    <Label text="Taille (Ko)"
                           style="-fx-text-fill: #A78BFA; -fx-font-size: 12px; -fx-font-weight: bold;"/>
                    <TextField fx:id="tailleField" editable="false"
                               style="-fx-background-color: rgba(15,15,26,0.6);
                                      -fx-text-fill: #B8B8D1;
                                      -fx-border-color: rgba(124,58,237,0.25);
                                      -fx-border-radius: 8;
                                      -fx-background-radius: 8;
                                      -fx-padding: 10 14;
                                      -fx-font-size: 13px;"/>
                    <Label fx:id="tailleError"
                           style="-fx-text-fill: #F87171; -fx-font-size: 11px;"/>
                </VBox>
                <VBox spacing="6" HBox.hgrow="ALWAYS">
                    <Label text="Format"
                           style="-fx-text-fill: #A78BFA; -fx-font-size: 12px; -fx-font-weight: bold;"/>
                    <TextField fx:id="formatField" editable="false"
                               style="-fx-background-color: rgba(15,15,26,0.6);
                                      -fx-text-fill: #B8B8D1;
                                      -fx-border-color: rgba(124,58,237,0.25);
                                      -fx-border-radius: 8;
                                      -fx-background-radius: 8;
                                      -fx-padding: 10 14;
                                      -fx-font-size: 13px;"/>
                    <Label fx:id="formatError"
                           style="-fx-text-fill: #F87171; -fx-font-size: 11px;"/>
                </VBox>
            </HBox>

            <!-- DATE + STATUT -->
            <HBox spacing="15">
                <VBox spacing="6" HBox.hgrow="ALWAYS">
                    <Label text="Date de publication *"
                           style="-fx-text-fill: #A78BFA; -fx-font-size: 12px; -fx-font-weight: bold;"/>
                    <DatePicker fx:id="dateField" maxWidth="Infinity"
                                style="-fx-background-color: rgba(15,15,26,0.9);
                                       -fx-border-color: rgba(124,58,237,0.4);
                                       -fx-border-radius: 8;
                                       -fx-background-radius: 8;"/>
                    <Label fx:id="dateError"
                           style="-fx-text-fill: #F87171; -fx-font-size: 11px;"/>
                </VBox>
                <VBox spacing="6" HBox.hgrow="ALWAYS">
                    <Label text="Statut *"
                           style="-fx-text-fill: #A78BFA; -fx-font-size: 12px; -fx-font-weight: bold;"/>
                    <ComboBox fx:id="statutField" promptText="Statut" maxWidth="Infinity"
                              style="-fx-background-color: rgba(15,15,26,0.9);
                                     -fx-border-color: rgba(124,58,237,0.4);
                                     -fx-border-radius: 8;
                                     -fx-background-radius: 8;"/>
                    <Label fx:id="statutError"
                           style="-fx-text-fill: #F87171; -fx-font-size: 11px;"/>
                </VBox>
            </HBox>

        </VBox>
    </ScrollPane>

    <!-- BOUTONS -->
    <HBox spacing="15" alignment="CENTER"
          style="-fx-background-color: rgba(37,37,54,0.8);
                 -fx-border-color: rgba(124,58,237,0.2);
                 -fx-border-width: 1 0 0 0;
                 -fx-padding: 18 28;">

        <Button fx:id="submitBtn" text="✅  Enregistrer les modifications"
                style="-fx-background-color: linear-gradient(to right, #7C3AED, #A78BFA);
                       -fx-text-fill: white;
                       -fx-background-radius: 10;
                       -fx-padding: 12 28;
                       -fx-font-size: 13px;
                       -fx-font-weight: bold;
                       -fx-cursor: hand;"/>

        <Button fx:id="cancelBtn" text="❌  Annuler"
                style="-fx-background-color: rgba(107,107,138,0.4);
                       -fx-text-fill: #B8B8D1;
                       -fx-background-radius: 10;
                       -fx-padding: 12 28;
                       -fx-font-size: 13px;
                       -fx-font-weight: bold;
                       -fx-cursor: hand;
                       -fx-border-color: rgba(107,107,138,0.3);
                       -fx-border-radius: 10;
                       -fx-border-width: 1;"/>
    </HBox>

</VBox>
